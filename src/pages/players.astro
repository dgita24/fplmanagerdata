---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import PlayerExplorer from "../components/PlayerExplorer.astro";
---
<Layout title="All FPL Players - FPL Manager Data">
  <Nav pageTitle="Players" />

  <main class="page">
    <header class="page-header">
      <div class="emoji-nav">
        <a class="page-title-emoji" href="/live" aria-label="Go to Live">📡</a>
        <a class="page-title-emoji" href="/leagues" aria-label="Go to Leagues">🏆</a>
        <a class="page-title-emoji" href="/stats" aria-label="Go to Stats">🔢</a>
        <a class="page-title-emoji" href="/transfers" aria-label="Go to Transfers">🔁</a>
        <a class="page-title-emoji" href="/ownership" aria-label="Go to Ownership">👥</a>
      </div>
      <p class="page-subtitle">Browse, search and filter every FPL player.</p>
    </header>

    <PlayerExplorer inline={true} />
  </main>
</Layout>
