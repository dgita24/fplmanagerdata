---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Account Settings - FPL Manager Watch">
  <main class="auth-page">
    <!-- Not logged in state -->
    <div id="not-logged-in" class="auth-card" style="display: none;">
      <h1 class="auth-title">Account Settings</h1>
      <p class="auth-notice">You need to be logged in to view account settings.</p>
      <a href="/login" class="btn btn--primary btn--full">Go to Login</a>
      <div class="auth-links">
        <a href="/" class="text-muted">← Back to Home</a>
      </div>
    </div>

    <!-- Logged in state -->
    <div id="logged-in" class="auth-card" style="display: none;">
      <h1 class="auth-title">⚙️ Account Settings</h1>

      <div class="account-email-row">
        <span class="label">Logged in as</span>
        <span id="current-email" class="account-email-value"></span>
      </div>

      <hr class="auth-divider-line" />

      <!-- Update Email -->
      <section>
        <h2 class="section-title">Update Email</h2>
        <form id="email-form" class="auth-form">
          <div class="control">
            <label class="label" for="new-email">New Email Address</label>
            <input type="email" id="new-email" class="input" required autocomplete="email" />
          </div>
          <button type="submit" class="btn btn--primary btn--full">Update Email</button>
          <div id="email-error" class="status status--error" style="display: none;"></div>
          <div id="email-success" class="status status--success" style="display: none;"></div>
        </form>
      </section>

      <hr class="auth-divider-line" />

      <!-- Update Password -->
      <section>
        <h2 class="section-title">Update Password</h2>
        <form id="password-form" class="auth-form">
          <div class="control">
            <label class="label" for="new-password">New Password</label>
            <div class="password-field">
              <input type="password" id="new-password" class="input" required minlength="6" autocomplete="new-password" />
              <button type="button" id="toggle-new-password" class="password-toggle" aria-label="Show password">👁</button>
            </div>
            <small class="auth-hint">Minimum 6 characters</small>
          </div>
          <div class="control">
            <label class="label" for="confirm-new-password">Confirm New Password</label>
            <div class="password-field">
              <input type="password" id="confirm-new-password" class="input" required minlength="6" autocomplete="new-password" />
              <button type="button" id="toggle-confirm-password" class="password-toggle" aria-label="Show password">👁</button>
            </div>
          </div>
          <button type="submit" class="btn btn--primary btn--full">Update Password</button>
          <div id="password-error" class="status status--error" style="display: none;"></div>
          <div id="password-success" class="status status--success" style="display: none;"></div>
        </form>
      </section>

      <hr class="auth-divider-line" />

      <section id="private-chips-tools" style="display: none;">
        <h2 class="section-title">Private Chip GW Export (Owner/Allowlist)</h2>
        <p class="auth-hint" style="margin-bottom: var(--space-3);">
          Export the gameweeks where managers in your list used chips this season.
        </p>
        <div style="display: flex; gap: var(--space-2); flex-wrap: wrap;">
          <button type="button" id="chips-export-download" class="btn btn--primary">Download CSV</button>
          <button type="button" id="chips-export-copy" class="btn btn--neutral">Copy JSON</button>
        </div>
        <div id="chips-export-status" class="status" style="display: none; margin-top: var(--space-3);"></div>
        <pre id="chips-export-preview" class="chips-export-preview"></pre>
      </section>

      <hr class="auth-divider-line" />

      <section id="private-analysis-tools" style="display: none;">
        <h2 class="section-title">Private Analysis Exports (Owner/Allowlist)</h2>
        <p class="auth-hint" style="margin-bottom: var(--space-3);">
          Export analysis-friendly manager datasets for your saved manager list.
        </p>
        <div class="private-export-grid">
          <div class="private-export-card">
            <h3 class="private-export-title">Manager GW Summary</h3>
            <div style="display: flex; gap: var(--space-2); flex-wrap: wrap;">
              <button type="button" id="summary-export-download" class="btn btn--primary">Download CSV</button>
              <button type="button" id="summary-export-copy" class="btn btn--neutral">Copy JSON</button>
            </div>
            <div id="summary-export-status" class="status" style="display: none; margin-top: var(--space-2);"></div>
          </div>
          <div class="private-export-card">
            <h3 class="private-export-title">Manager Transfers</h3>
            <div style="display: flex; gap: var(--space-2); flex-wrap: wrap;">
              <button type="button" id="transfers-export-download" class="btn btn--primary">Download CSV</button>
              <button type="button" id="transfers-export-copy" class="btn btn--neutral">Copy JSON</button>
            </div>
            <div id="transfers-export-status" class="status" style="display: none; margin-top: var(--space-2);"></div>
          </div>

          <div class="private-export-card">
            <h3 class="private-export-title">Manager Player Group Ownership</h3>
            <p class="auth-hint" style="margin-bottom: var(--space-2);">
              Search and select players to see which managers own all/any of them this gameweek.
            </p>

            <div class="control" style="margin-bottom: var(--space-2);">
              <label class="label" for="owners-player-search">Search and add players</label>
              <input
                id="owners-player-search"
                class="input"
                type="text"
                placeholder="Type player name (e.g. Palmer)"
                autocomplete="off"
              />
              <div id="owners-player-results" class="player-search-results"></div>
            </div>

            <div class="control" style="margin-bottom: var(--space-2);">
              <label class="label">Selected players</label>
              <div id="owners-selected-players" class="selected-player-chips"></div>
            </div>

            <div class="control" style="margin-bottom: var(--space-2);">
              <label class="label" for="owners-filter-mode">Match mode</label>
              <select id="owners-filter-mode" class="input">
                <option value="all" selected>Own ALL selected players (AND)</option>
                <option value="any">Own ANY selected player (OR)</option>
              </select>
            </div>

            <div style="display: flex; gap: var(--space-2); flex-wrap: wrap;">
              <button type="button" id="owners-export-download" class="btn btn--primary">Download CSV</button>
              <button type="button" id="owners-export-copy" class="btn btn--neutral">Copy JSON</button>
              <button type="button" id="owners-export-preview-btn" class="btn btn--neutral">Refresh Squads</button>
            </div>
            <div id="owners-export-status" class="status" style="display: none; margin-top: var(--space-2);"></div>
            <div id="owners-export-table" class="table-scroll"></div>
          </div>

          <div class="private-export-card">
            <h3 class="private-export-title">Managers by Club Player Count</h3>
            <p class="auth-hint" style="margin-bottom: var(--space-2);">
              Which managers own 1, 2 or 3 players from a chosen club?
            </p>
            <div class="control" style="margin-bottom: var(--space-2);">
              <label class="label" for="club-select">Club</label>
              <select id="club-select" class="input"></select>
            </div>
            <div class="control" style="margin-bottom: var(--space-2);">
              <label class="label" for="club-count">Number of players</label>
              <select id="club-count" class="input">
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3" selected>3</option>
              </select>
            </div>
            <div class="control" style="margin-bottom: var(--space-2);">
              <label class="label" for="club-mode">Match</label>
              <select id="club-mode" class="input">
                <option value="exact" selected>Exactly this many</option>
                <option value="atleast">At least this many</option>
              </select>
            </div>
            <div style="display: flex; gap: var(--space-2); flex-wrap: wrap;">
              <button type="button" id="club-export-download" class="btn btn--primary">Download CSV</button>
              <button type="button" id="club-export-copy" class="btn btn--neutral">Copy JSON</button>
              <button type="button" id="club-export-preview-btn" class="btn btn--neutral">Show / Refresh</button>
            </div>
            <div id="club-export-status" class="status" style="display: none; margin-top: var(--space-2);"></div>
            <div id="club-export-table" class="table-scroll"></div>
          </div>
        </div>
      </section>

      <div class="auth-links">
        <a href="/" class="text-muted">← Back to Home</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .auth-page {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }

  .auth-card {
    width: 100%;
    max-width: 440px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .auth-title {
    text-align: center;
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .auth-notice {
    text-align: center;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
  }

  .account-email-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
  }

  .account-email-value {
    font-weight: 600;
    color: var(--color-primary);
    word-break: break-all;
  }

  .auth-divider-line {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-5) 0;
  }

  .section-title {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .btn--full { width: 100%; }

  .auth-hint {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }

  .auth-links {
    margin-top: var(--space-5);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .password-field { position: relative; }

  .password-toggle {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: var(--color-text-secondary);
    cursor: pointer;
    font-size: 16px;
    padding: 0;
  }

  .chips-export-preview {
    margin-top: var(--space-3);
    max-height: 220px;
    overflow: auto;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .private-export-grid {
    display: grid;
    gap: var(--space-3);
  }

  .private-export-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    background: var(--color-surface-alt);
  }

  .private-export-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .player-search-results {
    margin-top: 6px;
    max-height: 180px;
    overflow: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .player-search-item {
    width: 100%;
    text-align: left;
    border: none;
    background: transparent;
    padding: 8px 10px;
    cursor: pointer;
    color: var(--color-text);
  }

  .player-search-item:hover {
    background: var(--color-surface-alt);
  }

  .selected-player-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .selected-player-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: var(--text-xs);
  }

  .selected-player-chip button {
    border: none;
    background: transparent;
    cursor: pointer;
    color: var(--color-text-secondary);
    padding: 0;
    line-height: 1;
  }

  .table-scroll {
    margin-top: var(--space-3);
    max-height: 360px;
    overflow: auto;
  }

  .table-scroll:empty {
    display: none;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-xs);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .data-table th,
  .data-table td {
    text-align: left;
    padding: 6px 8px;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }

  .data-table th {
    position: sticky;
    top: 0;
    background: var(--color-surface-alt);
    color: var(--color-text);
    font-weight: 600;
  }

  .data-table td {
    color: var(--color-text-secondary);
  }
</style>

<script>
  import { supabase } from '../lib/supabase.ts'
  import {
    loadSquads,
    matchOwners,
    matchClub,
    toCsv,
    escapeHtml,
    type LoadResult,
    type TableRow,
  } from '../lib/managerSquads.ts'

  const notLoggedIn = document.getElementById('not-logged-in') as HTMLElement
  const loggedIn = document.getElementById('logged-in') as HTMLElement
  const currentEmailEl = document.getElementById('current-email') as HTMLElement
  const privateChipTools = document.getElementById('private-chips-tools') as HTMLElement
  const privateAnalysisTools = document.getElementById('private-analysis-tools') as HTMLElement
  const chipsExportDownloadBtn = document.getElementById('chips-export-download') as HTMLButtonElement
  const chipsExportCopyBtn = document.getElementById('chips-export-copy') as HTMLButtonElement
  const chipsExportStatus = document.getElementById('chips-export-status') as HTMLElement
  const chipsExportPreview = document.getElementById('chips-export-preview') as HTMLElement
  const summaryExportDownloadBtn = document.getElementById('summary-export-download') as HTMLButtonElement
  const summaryExportCopyBtn = document.getElementById('summary-export-copy') as HTMLButtonElement
  const summaryExportStatus = document.getElementById('summary-export-status') as HTMLElement
  const transfersExportDownloadBtn = document.getElementById('transfers-export-download') as HTMLButtonElement
  const transfersExportCopyBtn = document.getElementById('transfers-export-copy') as HTMLButtonElement
  const transfersExportStatus = document.getElementById('transfers-export-status') as HTMLElement

  const ownersPlayerSearchInput = document.getElementById('owners-player-search') as HTMLInputElement
  const ownersPlayerResults = document.getElementById('owners-player-results') as HTMLElement
  const ownersSelectedPlayersEl = document.getElementById('owners-selected-players') as HTMLElement
  const ownersFilterModeSelect = document.getElementById('owners-filter-mode') as HTMLSelectElement
  const ownersExportDownloadBtn = document.getElementById('owners-export-download') as HTMLButtonElement
  const ownersExportCopyBtn = document.getElementById('owners-export-copy') as HTMLButtonElement
  const ownersExportPreviewBtn = document.getElementById('owners-export-preview-btn') as HTMLButtonElement
  const ownersExportStatus = document.getElementById('owners-export-status') as HTMLElement
  const ownersExportTable = document.getElementById('owners-export-table') as HTMLElement

  const clubSelect = document.getElementById('club-select') as HTMLSelectElement
  const clubCountSelect = document.getElementById('club-count') as HTMLSelectElement
  const clubModeSelect = document.getElementById('club-mode') as HTMLSelectElement
  const clubDownloadBtn = document.getElementById('club-export-download') as HTMLButtonElement
  const clubCopyBtn = document.getElementById('club-export-copy') as HTMLButtonElement
  const clubPreviewBtn = document.getElementById('club-export-preview-btn') as HTMLButtonElement
  const clubStatus = document.getElementById('club-export-status') as HTMLElement
  const clubTable = document.getElementById('club-export-table') as HTMLElement

  type ChipExportManager = {
    entryId: number
    managerName: string
    teamName: string
    allChipGws: number[]
    wildcardGws: number[]
    benchBoostGws: number[]
    tripleCaptainGws: number[]
    freeHitGws: number[]
    assistantManagerGws: number[]
  }

  type ChipExportResponse = {
    season: string
    generatedAt: string
    managerCount: number
    managers: ChipExportManager[]
  }

  type PrivateRowsResponse = {
    rows?: unknown[]
  }

  type BootstrapPlayer = {
    id: number
    web_name?: string
    first_name?: string
    second_name?: string
    team?: number
  }

  const PREVIEW_MANAGER_COUNT = 12
  const SQUADS_MAX_AGE_MS = 5 * 60 * 1000

  let chipExportPayload: ChipExportResponse | null = null
  let bootstrapPlayers: BootstrapPlayer[] = []
  let teamNameById = new Map<number, string>()
  let currentGw = 0
  const selectedPlayerMap = new Map<number, BootstrapPlayer>()

  // Client-side squads cache (shared by the owners + club tools)
  let squadsCache: LoadResult | null = null
  let squadsLoading: Promise<LoadResult> | null = null

  // Latest computed result rows (used for table, CSV and JSON copy)
  let ownersRows: TableRow[] = []
  let clubRows: TableRow[] = []

  type StatusType = 'success' | 'error' | 'warning'

  function setChipExportStatus(message: string, type: StatusType) {
    if (!chipsExportStatus) return
    chipsExportStatus.className = `status status--${type}`
    chipsExportStatus.textContent = message
    chipsExportStatus.style.display = 'block'
  }

  function setOwnersStatus(message: string, type: StatusType) {
    if (!ownersExportStatus) return
    ownersExportStatus.className = `status status--${type}`
    ownersExportStatus.textContent = message
    ownersExportStatus.style.display = 'block'
  }

  function setExportStatus(el: HTMLElement | null, message: string, type: StatusType) {
    if (!el) return
    el.className = `status status--${type}`
    el.textContent = message
    el.style.display = 'block'
  }

  async function getSessionToken(): Promise<string | null> {
    const { data: { session } } = await supabase.auth.getSession()
    return session?.access_token || null
  }

  async function fetchPrivateChipExport(format: 'json' | 'csv' = 'json'): Promise<Response> {
    return fetchPrivateExport('/api/private/chips-gameweeks', format)
  }

  async function fetchPrivateExport(path: string, format: 'json' | 'csv' = 'json'): Promise<Response> {
    const token = await getSessionToken()
    if (!token) throw new Error('No session token')

    const suffix = format === 'csv' ? '?format=csv' : ''
    return fetch(`${path}${suffix}`, {
      headers: {
        Authorization: `Bearer ${token}`,
      },
    })
  }

  function downloadCsv(csv: string, filename: string) {
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' })
    const objectUrl = URL.createObjectURL(blob)
    const link = document.createElement('a')
    link.href = objectUrl
    link.download = filename
    document.body.appendChild(link)
    link.click()
    link.remove()
    URL.revokeObjectURL(objectUrl)
  }

  function renderTable(container: HTMLElement, columns: Array<{ key: string; label: string }>, rows: TableRow[]) {
    if (rows.length === 0) {
      container.innerHTML = `<div class="auth-hint">No matching managers.</div>`
      return
    }
    container.innerHTML = `
      <table class="data-table">
        <thead><tr>${columns.map((c) => `<th>${escapeHtml(c.label)}</th>`).join('')}</tr></thead>
        <tbody>
          ${rows
            .map((r) => `<tr>${columns.map((c) => `<td>${escapeHtml(r[c.key] ?? '')}</td>`).join('')}</tr>`)
            .join('')}
        </tbody>
      </table>
    `
  }

  function playerDisplayName(p: BootstrapPlayer): string {
    const full = `${p.first_name || ''} ${p.second_name || ''}`.trim()
    return full ? `${p.web_name || full} (${full})` : (p.web_name || `Player ${p.id}`)
  }

  async function loadPlayersForPicker() {
    const res = await fetch('/api/fpl/bootstrap-static', { cache: 'no-store' })
    if (!res.ok) throw new Error('Failed to load players')
    const data = await res.json()

    const teams = Array.isArray(data?.teams) ? data.teams : []
    teamNameById = new Map<number, string>(teams.map((t: any) => [Number(t.id), String(t.name)]))
    clubSelect.innerHTML = teams
      .slice()
      .sort((a: any, b: any) => String(a.name).localeCompare(String(b.name)))
      .map((t: any) => `<option value="${t.id}">${escapeHtml(t.name)}</option>`)
      .join('')

    const events = Array.isArray(data?.events) ? data.events : []
    const ev = events.find((e: any) => e?.is_current) || events.find((e: any) => e?.is_next)
    currentGw = Number(ev?.id) || 0

    const els = Array.isArray(data?.elements) ? data.elements : []
    bootstrapPlayers = els
      .map((e: any) => ({
        id: Number(e?.id),
        web_name: e?.web_name,
        first_name: e?.first_name,
        second_name: e?.second_name,
        team: Number(e?.team),
      }))
      .filter((p: BootstrapPlayer) => Number.isFinite(p.id))
  }

  // ---------------------------------------------------------------------------
  // Shared squads loader (runs in the browser: no Cloudflare subrequest cap)
  // ---------------------------------------------------------------------------
  async function getManagerIds(): Promise<number[]> {
    const { data: { user } } = await supabase.auth.getUser()
    if (!user) throw new Error('Not logged in.')

    const { data, error } = await supabase
      .from('user_manager_lists')
      .select('manager_ids')
      .eq('user_id', user.id)
      .single()

    if (error && error.code !== 'PGRST116') throw new Error('Could not load your manager list.')

    return (Array.isArray(data?.manager_ids) ? data.manager_ids : [])
      .map((id: unknown) => Number(id))
      .filter((id: number) => Number.isInteger(id) && id > 0)
  }

  async function ensureSquads(
    statusFn: (message: string, type: StatusType) => void,
    force = false
  ): Promise<LoadResult> {
    if (!currentGw) throw new Error('Current gameweek is unknown. Reload the page.')

    const fresh = squadsCache && Date.now() - squadsCache.loadedAt < SQUADS_MAX_AGE_MS && squadsCache.gw === currentGw
    if (squadsCache && fresh && !force) return squadsCache

    if (!squadsLoading) {
      const ids = await getManagerIds()
      if (ids.length === 0) throw new Error('Your manager list is empty.')

      squadsLoading = loadSquads(ids, currentGw, {
        onProgress: (done, total) => statusFn(`Loading squads ${done}/${total}...`, 'warning'),
      }).finally(() => {
        squadsLoading = null
      })
    }

    squadsCache = await squadsLoading
    return squadsCache
  }

  function failureSuffix(res: LoadResult): string {
    return res.failed.length
      ? ` WARNING: ${res.failed.length} manager(s) failed to load (IDs: ${res.failed.join(', ')}). Click refresh to retry.`
      : ''
  }

  // ---------------------------------------------------------------------------
  // Player group ownership
  // ---------------------------------------------------------------------------
  function clearOwnersResults() {
    ownersRows = []
    ownersExportTable.innerHTML = ''
  }

  function computeOwners(res: LoadResult) {
    const selectedIds = [...selectedPlayerMap.keys()]
    const mode = ownersFilterModeSelect?.value === 'any' ? 'any' : 'all'
    const names = new Map(bootstrapPlayers.map((p) => [p.id, p.web_name || `Player ${p.id}`]))

    ownersRows = matchOwners(res.squads, selectedIds, mode).map((m) => ({
      entry_id: m.entryId,
      manager_name: m.managerName,
      team_name: m.teamName,
      matched_players: m.matched.map((id) => names.get(id) || `Player ${id}`).join('; '),
      selected_players: selectedIds.map((id) => names.get(id) || `Player ${id}`).join('; '),
    }))

    renderTable(
      ownersExportTable,
      [
        { key: 'manager_name', label: 'Manager' },
        { key: 'team_name', label: 'Team' },
        { key: 'matched_players', label: 'Matched' },
      ],
      ownersRows
    )

    setOwnersStatus(
      `GW${res.gw}: ${ownersRows.length} of ${res.squads.length} loaded managers match (${mode === 'any' ? 'ANY' : 'ALL'}).` +
        failureSuffix(res),
      res.failed.length ? 'warning' : 'success'
    )
  }

  async function refreshOwners(force = false): Promise<boolean> {
    if (selectedPlayerMap.size === 0) {
      clearOwnersResults()
      setOwnersStatus('Select at least one player first.', 'warning')
      return false
    }
    try {
      setOwnersStatus('Loading squads...', 'warning')
      const res = await ensureSquads(setOwnersStatus, force)
      computeOwners(res)
      return true
    } catch (error) {
      console.error('[account] owners refresh failed', error)
      setOwnersStatus((error as Error)?.message || 'Failed to load ownership data.', 'error')
      return false
    }
  }

  // Re-match instantly from the cache when the selection or mode changes
  function recomputeOwnersFromCache() {
    if (selectedPlayerMap.size === 0) {
      clearOwnersResults()
      return
    }
    if (squadsCache) computeOwners(squadsCache)
  }

  function renderSelectedPlayers() {
    if (!ownersSelectedPlayersEl) return
    const selected = [...selectedPlayerMap.values()]
    if (selected.length === 0) {
      ownersSelectedPlayersEl.innerHTML = `<span class="auth-hint">No players selected.</span>`
      return
    }

    ownersSelectedPlayersEl.innerHTML = selected.map((p) => `
      <span class="selected-player-chip">
        ${escapeHtml(playerDisplayName(p))}
        <button type="button" data-remove-player-id="${p.id}" aria-label="Remove ${escapeHtml(playerDisplayName(p))}">✕</button>
      </span>
    `).join('')

    ownersSelectedPlayersEl.querySelectorAll<HTMLButtonElement>('button[data-remove-player-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = Number(btn.dataset.removePlayerId)
        selectedPlayerMap.delete(id)
        renderSelectedPlayers()
        recomputeOwnersFromCache()
      })
    })
  }

  function renderPlayerSearchResults(query: string) {
    if (!ownersPlayerResults) return
    const q = query.trim().toLowerCase()
    if (!q) {
      ownersPlayerResults.innerHTML = ''
      return
    }

    const matches = bootstrapPlayers
      .filter((p) => {
        const full = `${p.first_name || ''} ${p.second_name || ''}`.trim().toLowerCase()
        const web = (p.web_name || '').toLowerCase()
        return web.includes(q) || full.includes(q)
      })
      .filter((p) => !selectedPlayerMap.has(p.id))
      .slice(0, 20)

    if (matches.length === 0) {
      ownersPlayerResults.innerHTML = `<div class="auth-hint" style="padding:8px 10px;">No matches</div>`
      return
    }

    ownersPlayerResults.innerHTML = matches.map((p) => `
      <button type="button" class="player-search-item" data-player-id="${p.id}">
        ${escapeHtml(playerDisplayName(p))}
      </button>
    `).join('')

    ownersPlayerResults.querySelectorAll<HTMLButtonElement>('button[data-player-id]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = Number(btn.dataset.playerId)
        const player = bootstrapPlayers.find((x) => x.id === id)
        if (!player) return
        selectedPlayerMap.set(player.id, player)
        ownersPlayerSearchInput.value = ''
        ownersPlayerResults.innerHTML = ''
        renderSelectedPlayers()
        // First selection triggers the squads load; later ones are instant.
        await refreshOwners(false)
      })
    })
  }

  // ---------------------------------------------------------------------------
  // Club player count
  // ---------------------------------------------------------------------------
  function computeClub(res: LoadResult) {
    const teamId = Number(clubSelect.value)
    const count = Number(clubCountSelect.value)
    const mode = clubModeSelect.value === 'atleast' ? 'atleast' : 'exact'
    const clubName = teamNameById.get(teamId) || `Team ${teamId}`
    const webNames = new Map(bootstrapPlayers.map((p) => [p.id, p.web_name || `Player ${p.id}`]))
    const clubPlayerIds = new Set(bootstrapPlayers.filter((p) => p.team === teamId).map((p) => p.id))

    clubRows = matchClub(res.squads, clubPlayerIds, count, mode)
      .map((m) => ({
        entry_id: m.entryId,
        manager_name: m.managerName,
        team_name: m.teamName,
        club: clubName,
        club_player_count: m.matched.length,
        players: m.matched.map((id) => webNames.get(id) || `Player ${id}`).sort().join('; '),
      }))
      .sort(
        (a, b) =>
          (b.club_player_count as number) - (a.club_player_count as number) ||
          String(a.manager_name).localeCompare(String(b.manager_name))
      )

    renderTable(
      clubTable,
      [
        { key: 'manager_name', label: 'Manager' },
        { key: 'team_name', label: 'Team' },
        { key: 'club_player_count', label: '#' },
        { key: 'players', label: 'Players' },
      ],
      clubRows
    )

    setExportStatus(
      clubStatus,
      `GW${res.gw}: ${clubRows.length} of ${res.squads.length} loaded managers match (${clubName}, ${mode === 'atleast' ? 'at least' : 'exactly'} ${count}).` +
        failureSuffix(res),
      res.failed.length ? 'warning' : 'success'
    )
  }

  async function refreshClub(force = false): Promise<boolean> {
    try {
      setExportStatus(clubStatus, 'Loading squads...', 'warning')
      const res = await ensureSquads((m, t) => setExportStatus(clubStatus, m, t), force)
      computeClub(res)
      return true
    } catch (error) {
      console.error('[account] club refresh failed', error)
      setExportStatus(clubStatus, (error as Error)?.message || 'Failed to load club data.', 'error')
      return false
    }
  }

  function recomputeClubFromCache() {
    if (squadsCache && clubTable.innerHTML) computeClub(squadsCache)
  }

  // ---------------------------------------------------------------------------
  // Init
  // ---------------------------------------------------------------------------
  async function init() {
    const { data: { user } } = await supabase.auth.getUser()

    if (!user) {
      notLoggedIn.style.display = 'block'
      return
    }

    if (currentEmailEl) currentEmailEl.textContent = user.email ?? ''
    loggedIn.style.display = 'block'

    try {
      await loadPlayersForPicker()
      renderSelectedPlayers()
    } catch (e) {
      console.error('[account] failed to load player picker data', e)
      setOwnersStatus('Could not load player list for search.', 'error')
    }

    try {
      const res = await fetchPrivateChipExport('json')
      if (res.status === 403 || res.status === 401) return
      if (!res.ok) {
        setChipExportStatus('Could not load private chip export.', 'error')
        privateChipTools.style.display = 'block'
        privateAnalysisTools.style.display = 'block'
        return
      }

      chipExportPayload = await res.json()
      privateChipTools.style.display = 'block'
      privateAnalysisTools.style.display = 'block'
      const previewRows = Array.isArray(chipExportPayload?.managers)
        ? chipExportPayload.managers.slice(0, PREVIEW_MANAGER_COUNT)
        : []
      chipsExportPreview.textContent = JSON.stringify(previewRows, null, 2)
      setChipExportStatus(`Loaded ${chipExportPayload?.managerCount ?? previewRows.length} managers.`, 'success')
    } catch (error) {
      console.error('[account] private chip export load failed', error)
      setChipExportStatus('Could not load private chip export.', 'error')
      privateChipTools.style.display = 'block'
      privateAnalysisTools.style.display = 'block'
    }
  }

  init()

  ownersPlayerSearchInput?.addEventListener('input', () => {
    renderPlayerSearchResults(ownersPlayerSearchInput.value)
  })

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement
    if (!target.closest('#owners-player-search') && !target.closest('#owners-player-results')) {
      if (ownersPlayerResults) ownersPlayerResults.innerHTML = ''
    }
  })

  // --- Update Email ---
  const emailForm = document.getElementById('email-form') as HTMLFormElement
  const emailError = document.getElementById('email-error') as HTMLElement
  const emailSuccess = document.getElementById('email-success') as HTMLElement

  emailForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    emailError.style.display = 'none'
    emailSuccess.style.display = 'none'

    const newEmail = (document.getElementById('new-email') as HTMLInputElement).value.trim()

    if (!newEmail) {
      emailError.textContent = 'Please enter a valid email address.'
      emailError.style.display = 'block'
      return
    }

    const { error } = await supabase.auth.updateUser({ email: newEmail })

    if (error) {
      emailError.textContent = error.message
      emailError.style.display = 'block'
    } else {
      emailSuccess.textContent = 'IMPORTANT! You must confirm the change in BOTH your old and new email inboxes.'
      emailSuccess.style.display = 'block'
    }
  })

  // --- Update Password ---
  const passwordForm = document.getElementById('password-form') as HTMLFormElement
  const passwordError = document.getElementById('password-error') as HTMLElement
  const passwordSuccess = document.getElementById('password-success') as HTMLElement

  const newPasswordInput = document.getElementById('new-password') as HTMLInputElement
  const confirmPasswordInput = document.getElementById('confirm-new-password') as HTMLInputElement
  const toggleNewPasswordBtn = document.getElementById('toggle-new-password') as HTMLButtonElement
  const toggleConfirmPasswordBtn = document.getElementById('toggle-confirm-password') as HTMLButtonElement

  toggleNewPasswordBtn?.addEventListener('click', () => {
    const isPassword = newPasswordInput.type === 'password'
    newPasswordInput.type = isPassword ? 'text' : 'password'
    toggleNewPasswordBtn.textContent = isPassword ? '🙈' : '👁'
  })

  toggleConfirmPasswordBtn?.addEventListener('click', () => {
    const isPassword = confirmPasswordInput.type === 'password'
    confirmPasswordInput.type = isPassword ? 'text' : 'password'
    toggleConfirmPasswordBtn.textContent = isPassword ? '🙈' : '👁'
  })

  passwordForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    passwordError.style.display = 'none'
    passwordSuccess.style.display = 'none'

    const newPassword = newPasswordInput.value
    const confirmPassword = confirmPasswordInput.value

    if (newPassword.length < 6) {
      passwordError.textContent = 'Password must be at least 6 characters.'
      passwordError.style.display = 'block'
      return
    }

    if (newPassword !== confirmPassword) {
      passwordError.textContent = 'Passwords do not match.'
      passwordError.style.display = 'block'
      return
    }

    const { error } = await supabase.auth.updateUser({ password: newPassword })

    if (error) {
      passwordError.textContent = error.message
      passwordError.style.display = 'block'
    } else {
      passwordSuccess.textContent = 'Password updated successfully!'
      passwordSuccess.style.display = 'block'
      passwordForm.reset()
    }
  })

  chipsExportDownloadBtn?.addEventListener('click', async () => {
    try {
      setChipExportStatus('Preparing CSV download...', 'warning')
      const res = await fetchPrivateChipExport('csv')
      if (!res.ok) {
        setChipExportStatus('Failed to generate CSV export.', 'error')
        return
      }

      downloadCsv(await res.text(), 'chip-gameweeks-current-season.csv')
      setChipExportStatus('CSV download started.', 'success')
    } catch (error) {
      console.error('[account] chip CSV export failed', error)
      setChipExportStatus('Failed to generate CSV export.', 'error')
    }
  })

  chipsExportCopyBtn?.addEventListener('click', async () => {
    if (!chipExportPayload) {
      setChipExportStatus('No export data loaded yet.', 'warning')
      return
    }
    try {
      await navigator.clipboard.writeText(JSON.stringify(chipExportPayload, null, 2))
      setChipExportStatus('Copied JSON export to clipboard.', 'success')
    } catch (error) {
      console.error('[account] chip export clipboard copy failed', error)
      setChipExportStatus('Failed to copy JSON export.', 'error')
    }
  })

  async function downloadPrivateCsv(path: string, filename: string, statusEl: HTMLElement, loadingText: string) {
    try {
      setExportStatus(statusEl, loadingText, 'warning')
      const res = await fetchPrivateExport(path, 'csv')
      if (!res.ok) {
        setExportStatus(statusEl, 'Failed to generate CSV export.', 'error')
        return
      }

      downloadCsv(await res.text(), filename)
      setExportStatus(statusEl, 'CSV download started.', 'success')
    } catch (error) {
      console.error('[account] CSV export failed', error)
      setExportStatus(statusEl, 'Failed to generate CSV export.', 'error')
    }
  }

  async function copyPrivateJson(path: string, statusEl: HTMLElement, emptyText: string) {
    try {
      setExportStatus(statusEl, 'Loading JSON export...', 'warning')
      const res = await fetchPrivateExport(path, 'json')
      if (!res.ok) {
        setExportStatus(statusEl, 'Failed to load JSON export.', 'error')
        return
      }
      const payload = await res.json() as PrivateRowsResponse
      const rows = Array.isArray(payload?.rows) ? payload.rows : []
      if (rows.length === 0) {
        setExportStatus(statusEl, emptyText, 'warning')
        return
      }
      await navigator.clipboard.writeText(JSON.stringify(payload, null, 2))
      setExportStatus(statusEl, `Copied JSON export (${rows.length} rows).`, 'success')
    } catch (error) {
      console.error('[account] JSON export copy failed', error)
      setExportStatus(statusEl, 'Failed to copy JSON export.', 'error')
    }
  }

  summaryExportDownloadBtn?.addEventListener('click', async () => {
    await downloadPrivateCsv(
      '/api/private/manager-gw-summary',
      'manager-gw-summary-current-season.csv',
      summaryExportStatus,
      'Preparing manager GW summary CSV...'
    )
  })

  summaryExportCopyBtn?.addEventListener('click', async () => {
    await copyPrivateJson(
      '/api/private/manager-gw-summary',
      summaryExportStatus,
      'No manager GW summary rows found.'
    )
  })

  transfersExportDownloadBtn?.addEventListener('click', async () => {
    await downloadPrivateCsv(
      '/api/private/manager-transfers',
      'manager-transfers-current-season.csv',
      transfersExportStatus,
      'Preparing manager transfers CSV...'
    )
  })

  transfersExportCopyBtn?.addEventListener('click', async () => {
    await copyPrivateJson(
      '/api/private/manager-transfers',
      transfersExportStatus,
      'No manager transfer rows found.'
    )
  })

  // --- Owners buttons (all client-side) ---
  ownersFilterModeSelect?.addEventListener('change', recomputeOwnersFromCache)

  ownersExportPreviewBtn?.addEventListener('click', async () => {
    // Force a fresh fetch of every manager's squad
    await refreshOwners(true)
  })

  ownersExportCopyBtn?.addEventListener('click', async () => {
    if (!(await refreshOwners(false))) return
    try {
      await navigator.clipboard.writeText(JSON.stringify(ownersRows, null, 2))
      setOwnersStatus(`Copied JSON export (${ownersRows.length} matches).`, 'success')
    } catch (error) {
      console.error('[account] owners JSON copy failed', error)
      setOwnersStatus('Failed to copy JSON export.', 'error')
    }
  })

  ownersExportDownloadBtn?.addEventListener('click', async () => {
    if (!(await refreshOwners(false))) return
    if (ownersRows.length === 0) {
      setOwnersStatus('No matching managers to export.', 'warning')
      return
    }
    downloadCsv(toCsv(ownersRows), 'manager-player-group-owners.csv')
    setOwnersStatus(`CSV download started (${ownersRows.length} managers).`, 'success')
  })

  // --- Club buttons (all client-side) ---
  clubSelect?.addEventListener('change', recomputeClubFromCache)
  clubCountSelect?.addEventListener('change', recomputeClubFromCache)
  clubModeSelect?.addEventListener('change', recomputeClubFromCache)

  clubPreviewBtn?.addEventListener('click', async () => {
    await refreshClub(true)
  })

  clubCopyBtn?.addEventListener('click', async () => {
    if (!(await refreshClub(false))) return
    try {
      await navigator.clipboard.writeText(JSON.stringify(clubRows, null, 2))
      setExportStatus(clubStatus, `Copied JSON (${clubRows.length} managers).`, 'success')
    } catch (e) {
      console.error('[account] club JSON copy failed', e)
      setExportStatus(clubStatus, 'Failed to copy JSON.', 'error')
    }
  })

  clubDownloadBtn?.addEventListener('click', async () => {
    if (!(await refreshClub(false))) return
    if (clubRows.length === 0) {
      setExportStatus(clubStatus, 'No matching managers to export.', 'warning')
      return
    }
    downloadCsv(toCsv(clubRows), 'manager-club-ownership.csv')
    setExportStatus(clubStatus, `CSV download started (${clubRows.length} managers).`, 'success')
  })
</script>
