---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="Privacy Policy - FPL Manager Watch">
  <Nav />

  <main class="page">
    <header class="page-header">
      <h1 class="page-title">Privacy Policy</h1>
      <p class="page-subtitle">Last updated: 2026-02-28</p>
    </header>

    <section class="card">
      <div class="card-body">
        <p>
          This Privacy Policy explains how FPL Manager Watch collects, uses, and protects your information.
        </p>

        <h2>Information collected</h2>
        <ul>
          <li>Account information (e.g. email) when you sign up/log in</li>
          <li>Basic usage data needed to operate the service (your publicaly available FPL data)</li>
        </ul>

        <h2>How information is used</h2>
        <ul>
          <li>To provide login and account features</li>
        </ul>

        <h2>Contact</h2>
        <p>If you have questions, contact us via the site owner.</p>
      </div>
    </section>
  </main>
</Layout>
