---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import PlayerModal from "../components/modals/PlayerModal.astro";
import GWPointsModal from "../components/modals/GWPointsModal.astro";
---
<Layout title="Player Ownership - FPL Manager Data">
  <Nav pageTitle="Ownership" />

  <main class="page">
    <header class="page-header">
      <div class="emoji-nav">
        <a class="page-title-emoji" href="/live" aria-label="Go to Live">📡</a>
        <a class="page-title-emoji" href="/leagues" aria-label="Go to Leagues">🏆</a>
        <a class="page-title-emoji" href="/stats" aria-label="Go to Stats">🔢</a>
        <a class="page-title-emoji" href="/transfers" aria-label="Go to Transfers">🔁</a>
        <a class="page-title-emoji" href="/players" aria-label="Go to Players">👕</a>
      </div>
      <p class="page-subtitle">See which players are owned by how many managers.</p>
    </header>

    <div class="meta-row-wide">
      <select id="club-filter" class="badge badge-wide club-filter-select">
        <option value="">⚽ All Clubs</option>
      </select>
      <button id="manager-count" class="badge badge-wide badge-toggle" type="button">⭐ Toggle Favourites</button>
    </div>

    <div class="controls-inline">
      <div class="control-inline">
        <label class="label-small" for="gw-filter">Gameweek</label>
        <select class="select-small" id="gw-filter">
          <option value="">Select GW</option>
        </select>
      </div>
      <div class="control-inline">
        <label class="label-small" for="position-filter">Position</label>
        <select class="select-small" id="position-filter">
          <option value="">All</option>
          <option value="GK">GK</option>
          <option value="DEF">DEF</option>
          <option value="MID">MID</option>
          <option value="FWD">FWD</option>
        </select>
      </div>
      <div class="control-inline">
        <label class="label-small">&nbsp;</label>
        <button id="refresh-btn" class="btn-row" type="button">🔄 Refresh</button>
      </div>
    </div>

    <div class="status-row">
      <div id="loading-status" class="meta-row"></div>
      <div id="last-updated" class="meta-row"></div>
    </div>
    <section id="ownership-output" aria-live="polite"></section>
  </main>

  <!-- Ownership Modal edit here this text to force cloudflare deploy -->
  <div id="ownership-modal" class="modal">
    <div class="modal-panel">
      <button id="close-ownership-modal" class="btn btn--danger btn--small modal-close" type="button">✕</button>
      <div id="ownership-modal-content"></div>
    </div>
  </div>

  <!-- Player Stats Modal -->
  <PlayerModal />

  <GWPointsModal />
</Layout>

<style>
  .meta-row-wide {
    display: flex;
    gap: var(--space-2);
  }

  .badge-wide {
    flex: 1;
    justify-content: center;
    padding: var(--space-2) var(--space-3);
    text-align: center;
  }

  .badge-toggle {
    cursor: pointer;
    transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    border: 1px solid var(--color-border);
  }

  .badge-toggle:hover {
    background: var(--color-surface-alt);
  }

  .badge-toggle--active {
    background: rgb(245 158 11 / 0.15) !important;
    border-color: rgb(245 158 11 / 0.4) !important;
    color: var(--color-warning) !important;
  }

  .club-filter-select {
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .controls-inline {
    display: flex;
    gap: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
  }

  .control-inline {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .label-small {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-align: center;
  }

  .select-small {
    width: 100%;
    min-height: 32px;
    padding: 6px 8px;
    font-family: inherit;
    font-size: 13px;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .select-small:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .btn-row {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    padding: 6px 8px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    color: white;
    background: var(--color-primary);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .btn-row:hover {
    background: var(--color-primary-hover);
  }

  /* Tighten gap between status row and ownership table.
     .page flex gap = 8px (mobile) / 20px (≥640px).
     Negative margin-bottom offsets that gap to ~4px / ~8px. */
  .status-row {
    margin-bottom: -4px; /* 8px page-gap − 4px = ~4px net */
  }

  @media (min-width: 640px) {
    .status-row {
      margin-bottom: -12px; /* 20px page-gap − 12px = ~8px net */
    }
  }

  :global(.player-name-modal-btn) {
    background: none;
    border: none;
    color: var(--color-warning);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    padding: 0;
    text-align: left;
    transition: color 0.2s;
  }

  :global(.player-name-modal-btn:hover) {
    color: var(--color-primary);
  }

</style>

<script>
  import { supabase } from '../lib/supabase.ts'
  import { initGWPointsModal, makePlayerNameClickable } from '../lib/gwPointsModal.js';

  async function loadManagerIdsFromSupabase() {
    const { data: { user } } = await supabase.auth.getUser()

    if (!user) {
      window.location.replace('/login')
      return { authenticated: false, managerIds: [], favouriteManagerIds: [] }
    }

    try {
      const { data, error } = await supabase
        .from('user_manager_lists')
        .select('manager_ids, favourite_manager_ids')
        .eq('user_id', user.id)
        .single()

      if (error && error.code !== 'PGRST116') {
        console.error('Error loading manager IDs:', error)
        return { authenticated: true, managerIds: [], favouriteManagerIds: [] }
      }

      return {
        authenticated: true,
        managerIds: data?.manager_ids || [],
        favouriteManagerIds: data?.favourite_manager_ids || [],
      }
    } catch (e) {
      console.error('Error:', e)
      return { authenticated: false, managerIds: [], favouriteManagerIds: [] }
    }
  }

  const out = document.getElementById("ownership-output");
  const gwFilterSelect = document.getElementById("gw-filter");
  const positionFilter = document.getElementById("position-filter");
  const loadingStatus = document.getElementById("loading-status");
  const lastUpdatedEl = document.getElementById("last-updated");
  const refreshBtn = document.getElementById("refresh-btn");
  const ownershipModal = document.getElementById("ownership-modal");
  const ownershipModalContent = document.getElementById("ownership-modal-content");
  const closeOwnershipModal = document.getElementById("close-ownership-modal");
  const clubFilter = document.getElementById("club-filter") as HTMLSelectElement;
  const playerModal = document.getElementById("player-modal")!;
  const playerModalContent = document.getElementById("player-modal-content")!;
  const closePlayerModal = document.getElementById("close-player-modal")!;

  let managerIds = [];
  let ownershipData = [];
  let latestGW = null;
  let playerCache = new Map();
  let teamCache = new Map();
  const UNKNOWN_TEAM = { short: "???", full: "???" };
  // Each entry is { id: number, name: string } so duplicate names are handled correctly.
  let allManagers = [];
  // IDs of managers who played Free Hit in the currently selected GW.
  let freeHitManagers = new Set();
  let showFavouritesOnly = false;
  let favouriteIds = new Set<number>();
  const managerCountEl = document.getElementById("manager-count");
  
  // Load token for cancellation
  let currentLoadToken = 0;

  function formatUpdateTime(timestamp) {
    const date = new Date(timestamp);
    const today = new Date();
    const isToday = date.toDateString() === today.toDateString();
    
    if (isToday) {
      return `Updated: ${date.toLocaleTimeString()}`;
    } else {
      return `Updated: ${date.toLocaleDateString()} ${date.toLocaleTimeString()}`;
    }
  }
  const DEFAULT_FETCH_CONCURRENCY = 4;

  // ==============================
  // Persistent page cache (Ownership) - cached until Refresh
  // ==============================
  const OWNERSHIP_SNAPSHOT_KEY = "fpl_ownership_snapshot_v2";

  function safeJsonParse(value) {
    if (!value) return null;
    try { return JSON.parse(value); } catch { return null; }
  }

  function normalizeIds(ids) {
    return (Array.isArray(ids) ? ids : [])
      .map((x) => Number(x))
      .filter((n) => Number.isFinite(n));
  }

  function sameManagerIds(a, b) {
    const aa = normalizeIds(a).sort((x, y) => x - y);
    const bb = normalizeIds(b).sort((x, y) => x - y);
    if (aa.length !== bb.length) return false;
    for (let i = 0; i < aa.length; i++) if (aa[i] !== bb[i]) return false;
    return true;
  }

  function loadOwnershipSnapshot() {
    return safeJsonParse(localStorage.getItem(OWNERSHIP_SNAPSHOT_KEY));
  }

  function saveOwnershipSnapshot(gw) {
    const snap = {
      savedAt: Date.now(),
      managerIds: [...managerIds],
      gw,
      latestGW,
      ownershipData,
      allManagers,
      freeHitManagers: Array.from(freeHitManagers),
      ui: {
        gwFilter: gwFilterSelect.value || "",
        positionFilter: positionFilter.value || "",
        clubFilter: clubFilter.value || "",
        showFavouritesOnly,
      },
    };

    try {
      localStorage.setItem(OWNERSHIP_SNAPSHOT_KEY, JSON.stringify(snap));
    } catch (e) {
      console.warn("Could not save ownership snapshot", e);
    }
  }

  function renderOwnershipFromState() {
    const posFilter = positionFilter.value;
    const teamFilter = clubFilter.value;

    if (showFavouritesOnly) {
      if (favouriteIds.size === 0) {
        out.innerHTML = "<p class='status status--warning'>No favourites set yet. Add favourites on the Live page (⭐) then come back here.</p>";
        return;
      }

      const managersForDisplay = allManagers.filter(m => favouriteIds.has(m.id));
      const totalFavManagers = managersForDisplay.length;

      const filteredOwnershipData = ownershipData.map(player => {
        const favOwnedBy = player.ownedBy.filter(id => favouriteIds.has(id));
        return { ...player, ownedBy: favOwnedBy, count: favOwnedBy.length };
      }).filter(player => player.count > 0);

      out.innerHTML = makeOwnershipTable(filteredOwnershipData, posFilter, teamFilter, totalFavManagers);
    } else {
      out.innerHTML = makeOwnershipTable(ownershipData, posFilter, teamFilter);
    }
    attachPlayerButtons();
  }

  function populateClubFilter() {
    const current = clubFilter.value;
    const dataForClubs = showFavouritesOnly && favouriteIds.size > 0
      ? ownershipData.filter(p => p.ownedBy.some(id => favouriteIds.has(id)))
      : ownershipData;
    const teams = [...new Set(dataForClubs.map(p => p.teamName).filter(Boolean))].sort();
    clubFilter.innerHTML = '<option value="">⚽ All Clubs</option>';
    teams.forEach(team => {
      const opt = document.createElement('option');
      opt.value = team;
      const entry = ownershipData.find(p => p.teamName === team);
      opt.textContent = (entry?.teamFullName || team);
      clubFilter.appendChild(opt);
    });
    if (current && teams.includes(current)) clubFilter.value = current;
  }



  closeOwnershipModal.addEventListener("click", () => {
    ownershipModal.classList.remove("is-open");
  });

  closePlayerModal.addEventListener("click", () => {
    playerModal.classList.remove("is-open");
  });

  function updateManagerCountButton() {
    if (!managerCountEl) return;
    managerCountEl.textContent = `⭐ Toggle Favourites`;
    if (showFavouritesOnly) {
      managerCountEl.classList.add('badge-toggle--active');
    } else {
      managerCountEl.classList.remove('badge-toggle--active');
    }
  }

  async function saveFavouritesToSupabase(ids: number[]) {
    try {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) return;
      const { error } = await supabase
        .from('user_manager_lists')
        .update({ favourite_manager_ids: ids, updated_at: new Date().toISOString() })
        .eq('user_id', user.id);
      if (error) console.error('Error saving favourites:', error);
    } catch (e) {
      console.error('Error saving favourites:', e);
    }
  }

  async function toggleFavourite(entryId: number) {
    if (favouriteIds.has(entryId)) {
      favouriteIds.delete(entryId);
    } else {
      favouriteIds.add(entryId);
    }
    updateManagerCountButton();
    renderOwnershipFromState();
    await saveFavouritesToSupabase([...favouriteIds]);
  }

  managerCountEl?.addEventListener("click", () => {
    showFavouritesOnly = !showFavouritesOnly;
    updateManagerCountButton();
    populateClubFilter();
    renderOwnershipFromState();
    saveOwnershipSnapshot(parseInt(gwFilterSelect.value) || latestGW);
  });

  const gwPointsModal = initGWPointsModal('gw-points-modal');

  /**
   * Concurrent mapping with limited concurrency
   */
  async function mapWithConcurrency<T, R>(
    items: T[],
    limit: number,
    fn: (item: T, index: number) => Promise<R | null>,
    onProgress?: (completed: number, total: number) => void
  ): Promise<(R | null)[]> {
    const results: (R | null)[] = [];
    let currentIndex = 0;
    let completed = 0;

    async function worker() {
      while (currentIndex < items.length) {
        const index = currentIndex++;
        const item = items[index];
        try {
          results[index] = await fn(item, index);
        } catch (e) {
          console.error(`Error processing item ${index}:`, e);
          results[index] = null;
        }
        completed++;
        if (onProgress) {
          onProgress(completed, items.length);
        }
      }
    }

    const workers = Array.from({ length: Math.min(limit, items.length) }, () => worker());
    await Promise.all(workers);
    return results;
  }

  function populateGWSelector(currentGW) {
    gwFilterSelect.innerHTML = '';
    for (let i = 1; i <= 38; i++) {
      const option = document.createElement('option');
      option.value = i;
      option.textContent = `GW ${i}`;
      if (i === currentGW) option.selected = true;
      gwFilterSelect.appendChild(option);
    }
  }

  async function fetchBootstrapData(cacheBuster?: string) {
    try {
      const url = cacheBuster
        ? `/api/fpl/bootstrap-static?v=${cacheBuster}`
        : `/api/fpl/bootstrap-static`;

      const res = await fetch(url);
      if (!res.ok) throw new Error("Failed to fetch bootstrap data");
      const data = await res.json();

      playerCache.clear();
      teamCache.clear();

      data.elements.forEach(player => {
        playerCache.set(player.id, {
          name: player.web_name,
          position: player.element_type === 1 ? "GK" :
                    player.element_type === 2 ? "DEF" :
                    player.element_type === 3 ? "MID" : "FWD",
          team: player.team,
          totalPoints: player.total_points,
          selectedByPercent: player.selected_by_percent,
          goalsScored: player.goals_scored,
          assists: player.assists,
          cleanSheets: player.clean_sheets,
          penaltiesSaved: player.penalties_saved,
          penaltiesMissed: player.penalties_missed,
          yellowCards: player.yellow_cards,
          redCards: player.red_cards,
          bonus: player.bonus
        });
      });

      data.teams.forEach(team => {
        teamCache.set(team.id, { short: team.short_name, full: team.name });
      });

      const currentEvent = data.events.find(e => e.is_current);
      latestGW = currentEvent ? currentEvent.id : 1;

      populateGWSelector(latestGW);
    } catch (e) {
      console.error("Error fetching bootstrap data:", e);
    }
  }

  async function fetchManagerSquad(entryId, gw, cacheBuster?: string) {
    try {
      const picksUrl = cacheBuster
        ? `/api/fpl/entry/${entryId}/event/${gw}/picks?v=${cacheBuster}`
        : `/api/fpl/entry/${entryId}/event/${gw}/picks`;

      const summaryUrl = cacheBuster
        ? `/api/fpl/entry/${entryId}?v=${cacheBuster}`
        : `/api/fpl/entry/${entryId}`;

      const historyUrl = cacheBuster
        ? `/api/fpl/entry/${entryId}/history?v=${cacheBuster}`
        : `/api/fpl/entry/${entryId}/history`;

      const [picksRes, summaryRes, historyRes] = await Promise.all([
        fetch(picksUrl),
        fetch(summaryUrl),
        fetch(historyUrl)
      ]);

      if (!picksRes.ok || !summaryRes.ok || !historyRes.ok) throw new Error("Failed to fetch data");

      const picksData = await picksRes.json();
      const summaryData = await summaryRes.json();
      const historyData = await historyRes.json();

      const managerName = `${summaryData.player_first_name} ${summaryData.player_last_name}`;

      const chips = historyData?.chips || [];
      const isFreeHit = chips.some(c => c.name === 'freehit' && Number(c.event) === Number(gw));

      return {
        entryId,
        managerName,
        isFreeHit,
        picks: picksData.picks.map(p => p.element)
      };
    } catch (e) {
      console.error(`Error fetching squad for ${entryId}:`, e);
      return null;
    }
  }


  function calculateOwnership(managerSquads) {
    const ownership = new Map();

    for (const manager of managerSquads) {
      for (const playerId of manager.picks) {
        if (!ownership.has(playerId)) {
          const playerInfo = playerCache.get(playerId) || { name: "Unknown", position: "?", team: 0 };
          const teamInfo = teamCache.get(playerInfo.team) || UNKNOWN_TEAM;

          ownership.set(playerId, {
            playerId,
            playerName: playerInfo.name,
            position: playerInfo.position,
            teamName: typeof teamInfo === "string" ? teamInfo : teamInfo.short,
            teamFullName: typeof teamInfo === "string" ? teamInfo : teamInfo.full,
            ownedBy: [],
            count: 0
          });
        }

        const entry = ownership.get(playerId);
        entry.ownedBy.push(Number(manager.entryId));
        entry.count++;
      }
    }

    return Array.from(ownership.values());
  }

  async function fetchPlayerDefconStats(playerId: number): Promise<{ totalDefcon: number; gamesWithDefcon: number }> {
    try {
      const { data, error } = await supabase
        .from('player_defensive_stats')
        .select('defcon_points')
        .eq('player_id', playerId);

      if (error || !data) return { totalDefcon: 0, gamesWithDefcon: 0 };

      const totalDefcon = data.reduce((sum, row) => sum + (row.defcon_points || 0), 0);
      const gamesWithDefcon = data.filter(row => row.defcon_points > 0).length;

      return { totalDefcon, gamesWithDefcon };
    } catch (e) {
      console.error('Error fetching DEFCON stats:', e);
      return { totalDefcon: 0, gamesWithDefcon: 0 };
    }
  }

  async function showPlayerModal(playerId: number) {
    const player = playerCache.get(playerId);
    if (!player) return;

    const teamInfo = teamCache.get(player.team) || { short: "???", full: "???" };

    // FPL point calculation helpers
    const pos = player.position; // "GK" | "DEF" | "MID" | "FWD"

    const goalPts = (goals: number) => {
      if (!goals) return 0;
      const ppg = pos === "GK" || pos === "DEF" ? 6 : pos === "MID" ? 5 : 4;
      return goals * ppg;
    };
    const assistPts = (n: number) => (n || 0) * 3;
    const csPts = (n: number) => {
      if (!n) return 0;
      const pp = pos === "GK" || pos === "DEF" ? 4 : pos === "MID" ? 1 : 0;
      return n * pp;
    };
    const penSavedPts = (n: number) => (n || 0) * 5;
    const penMissedPts = (n: number) => (n || 0) * -2;
    const yellowPts = (n: number) => (n || 0) * -1;
    const redPts = (n: number) => (n || 0) * -3;

    const fmtPts = (pts: number): string => {
      if (pts === 0) return "—";
      return pts > 0 ? `+${pts}` : `${pts}`;
    };
    const ptsClass = (pts: number) =>
      pts > 0 ? "points-positive" : pts < 0 ? "points-negative" : "";

    const goals       = player.goalsScored ?? 0;
    const assists     = player.assists ?? 0;
    const cs          = player.cleanSheets ?? 0;
    const penSaved    = player.penaltiesSaved ?? 0;
    const penMissed   = player.penaltiesMissed ?? 0;
    const yellows     = player.yellowCards ?? 0;
    const reds        = player.redCards ?? 0;
    const bonus       = player.bonus ?? 0;

    const gp = goalPts(goals);
    const ap = assistPts(assists);
    const cp = csPts(cs);
    const psp = penSavedPts(penSaved);
    const pmp = penMissedPts(penMissed);
    const yp = yellowPts(yellows);
    const rp = redPts(reds);

    // Fetch DEFCON stats for outfield players
    const isOutfield = pos !== "GK";
    let defconStats = { totalDefcon: 0, gamesWithDefcon: 0 };
    if (isOutfield) {
      defconStats = await fetchPlayerDefconStats(playerId);
    }

    let html = `
      <div class="player-modal-header">
        <div class="player-modal-info">
          <h2 class="player-modal-name">${player.name}</h2>
          <div class="player-modal-meta">
            <span class="player-modal-team">${teamInfo.short}</span>
            <span class="player-modal-pos">${pos}</span>
          </div>
        </div>
        <div class="player-modal-points">
          <span class="player-modal-total">${player.totalPoints ?? '—'}</span>
          <span class="player-modal-pts-label">pts</span>
        </div>
      </div>

      <div class="player-modal-breakdown">
        <h3 class="player-modal-section-title">Season Stats</h3>
        <div class="breakdown-list">
          <div class="breakdown-row">
            <span class="breakdown-label">Goals</span>
            <span class="breakdown-value">${goals}</span>
            <span class="breakdown-points ${ptsClass(gp)}">${fmtPts(gp)}</span>
          </div>
          <div class="breakdown-row">
            <span class="breakdown-label">Assists</span>
            <span class="breakdown-value">${assists}</span>
            <span class="breakdown-points ${ptsClass(ap)}">${fmtPts(ap)}</span>
          </div>
          <div class="breakdown-row">
            <span class="breakdown-label">Clean Sheets</span>
            <span class="breakdown-value">${cs}</span>
            <span class="breakdown-points ${ptsClass(cp)}">${fmtPts(cp)}</span>
          </div>
          ${isOutfield && defconStats.totalDefcon > 0 ? `
          <div class="breakdown-row">
            <span class="breakdown-label">DEFCON Points</span>
            <span class="breakdown-value">${defconStats.gamesWithDefcon} games</span>
            <span class="breakdown-points points-positive">+${defconStats.totalDefcon}</span>
          </div>` : ''}
          <div class="breakdown-row">
            <span class="breakdown-label">Bonus Points</span>
            <span class="breakdown-value">${bonus}</span>
            <span class="breakdown-points ${ptsClass(bonus)}">${fmtPts(bonus)}</span>
          </div>
          ${pos === "GK" ? `
          <div class="breakdown-row">
            <span class="breakdown-label">Pen Saved</span>
            <span class="breakdown-value">${penSaved}</span>
            <span class="breakdown-points ${ptsClass(psp)}">${fmtPts(psp)}</span>
          </div>` : ''}
          ${penMissed > 0 ? `
          <div class="breakdown-row">
            <span class="breakdown-label">Pen Missed</span>
            <span class="breakdown-value">${penMissed}</span>
            <span class="breakdown-points ${ptsClass(pmp)}">${fmtPts(pmp)}</span>
          </div>` : ''}
          <div class="breakdown-row">
            <span class="breakdown-label">Yellow Cards</span>
            <span class="breakdown-value">${yellows || '—'}</span>
            <span class="breakdown-points ${ptsClass(yp)}">${fmtPts(yp)}</span>
          </div>
          <div class="breakdown-row">
            <span class="breakdown-label">Red Cards</span>
            <span class="breakdown-value">${reds || '—'}</span>
            <span class="breakdown-points ${ptsClass(rp)}">${fmtPts(rp)}</span>
          </div>
          <div class="breakdown-row">
            <span class="breakdown-label">Selected by</span>
            <span class="breakdown-value">${player.selectedByPercent ?? '—'}%</span>
            <span class="breakdown-points"></span>
          </div>
        </div>
      </div>
    `;

    playerModalContent.innerHTML = html;
    const playerNameEl = playerModalContent.querySelector('.player-modal-name');
    if (playerNameEl && gwPointsModal) {
      const teamMap = new Map();
      teamCache.forEach((v, k) => teamMap.set(k, { name: v.full, shortName: v.short }));
      makePlayerNameClickable(playerNameEl, playerId, player.name, gwPointsModal, teamMap);
    }
    playerModal.classList.add("is-open");
  }

  function showOwnershipModal(playerName: string, position: string, teamName: string, ownedByList: number[], playerId: number) {
    const managersForModal = showFavouritesOnly ? allManagers.filter(m => favouriteIds.has(m.id)) : allManagers;
    const filteredOwnedByList = showFavouritesOnly ? ownedByList.filter(id => favouriteIds.has(id)) : ownedByList;
    const totalManagers = managersForModal.length;
    const notOwnedBy = managersForModal.filter(m => !filteredOwnedByList.includes(m.id)).sort((a, b) => a.name.localeCompare(b.name));
    const ownedBySorted = managersForModal.filter(m => filteredOwnedByList.includes(m.id)).sort((a, b) => a.name.localeCompare(b.name));
    const ownershipPct = ((filteredOwnedByList.length / totalManagers) * 100).toFixed(0);

    const allOwn = filteredOwnedByList.length === totalManagers;
    const noneOwn = filteredOwnedByList.length === 0;
    const fhCount = freeHitManagers.size;


    const nameWithFH = (manager) => {
      return freeHitManagers.has(manager.id)
        ? `${manager.name} <span class="text-muted" title="Played Free Hit in this GW">🎯 FH</span>`
        : manager.name;
    };


    let html = `
      <h2 class="modal-title" style="padding-right:40px;">
        <button type="button" class="player-name-modal-btn" data-player-id="${playerId}">${playerName}</button>
      </h2>
      <p class="text-muted" style="margin-bottom:var(--space-4);">
        ${position} · ${teamName} · <span class="text-success font-bold">${ownershipPct}%</span> ownership
      </p>
    `;


    if (allOwn) {
      html += `
        <div class="ownership-section ownership-section--success">
          <div class="ownership-section-header">
            <span class="ownership-section-title">✓ Owned by everyone</span>
            <span class="ownership-section-count">${totalManagers}/${totalManagers}</span>
          </div>
        </div>
      `;
    } else if (noneOwn) {
      html += `
        <div class="ownership-section ownership-section--danger">
          <div class="ownership-section-header">
            <span class="ownership-section-title">✗ Not owned by anyone</span>
            <span class="ownership-section-count">0/${totalManagers}</span>
          </div>
        </div>
      `;
    } else {
      html += `
        <div class="ownership-section ownership-section--success">
          <div class="ownership-section-header">
            <span class="ownership-section-title">👍 Owned by</span>
            <span class="ownership-section-count">${ownedBySorted.length}/${totalManagers}</span>
          </div>
          <ul class="ownership-list">
            ${ownedBySorted.map(m => `<li class="ownership-list-item ownership-list-item--owned">${nameWithFH(m)}</li>`).join('')}
          </ul>
        </div>

        <div class="ownership-section ownership-section--danger">
          <div class="ownership-section-header">
            <span class="ownership-section-title">👎 Not owned by</span>
            <span class="ownership-section-count">${notOwnedBy.length}/${totalManagers}</span>
          </div>
          <ul class="ownership-list">
            ${notOwnedBy.map(m => `<li class="ownership-list-item ownership-list-item--not-owned">${nameWithFH(m)}</li>`).join('')}
          </ul>
        </div>
      `;
    }

    ownershipModalContent.innerHTML = html;
    ownershipModal.classList.add("is-open");

    const playerNameBtn = ownershipModalContent.querySelector('.player-name-modal-btn');
    if (playerNameBtn) {
      playerNameBtn.addEventListener('click', () => {
        const pid = parseInt((playerNameBtn as HTMLElement).dataset.playerId || '0');
        if (pid) showPlayerModal(pid);
      });
    }
  }

  function makeOwnershipTable(ownership, positionFilterValue = "", teamFilterValue = "", totalManagersOverride?: number) {
    let filtered = ownership;

    if (positionFilterValue) {
      filtered = filtered.filter(p => p.position === positionFilterValue);
    }

    if (teamFilterValue) {
      filtered = filtered.filter(p => p.teamName === teamFilterValue);
    }

    filtered.sort((a, b) => {
      if (b.count !== a.count) return b.count - a.count;
      return a.playerName.localeCompare(b.playerName);
    });

    const totalManagers = totalManagersOverride !== undefined ? totalManagersOverride : allManagers.length;

    let html = `
      <div class="meta-row" style="margin-bottom:8px;">
        <span>Managers: <strong>${totalManagers}</strong></span>
        <span>Players: <strong>${filtered.length}</strong></span>
      </div>

      <div class="table-container">
        <div class="table-scroll">
          <table class="data-table ownership-table">
            <thead>
              <tr>
                <th>Player</th>
                <th class="pos-cell">Pos</th>
                <th class="team-cell">Team</th>
                <th class="pct-cell">%</th>
              </tr>
            </thead>
            <tbody>
    `;

    for (const player of filtered) {
      const ownershipPct = ((player.count / totalManagers) * 100).toFixed(0);
      const ownedByJson = JSON.stringify(player.ownedBy).replace(/"/g, '&quot;');

      html += `
        <tr>
          <td class="player-cell">
            <button type="button" class="player-btn"
              data-player="${player.playerName}"
              data-position="${player.position}"
              data-team="${player.teamName}"
              data-owned="${ownedByJson}"
              data-player-id="${player.playerId}"
            >
              <span class="player-name">${player.playerName}</span>
              <span class="player-count">${player.count} of ${totalManagers}</span>
            </button>
          </td>
          <td class="pos-cell">${player.position}</td>
          <td class="team-cell">${player.teamName}</td>
          <td class="pct-cell">${ownershipPct}%</td>
        </tr>
      `;
    }

    html += `
            </tbody>
          </table>
        </div>
      </div>
    `;

    return html;
  }

  function attachPlayerButtons() {
    document.querySelectorAll('.player-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const button = e.target.closest('.player-btn');
        const playerName = button.dataset.player;
        const position = button.dataset.position;
        const teamName = button.dataset.team;
        const ownedBy = JSON.parse(button.dataset.owned);
        const playerId = parseInt(button.dataset.playerId || '0');
        showOwnershipModal(playerName, position, teamName, ownedBy, playerId);
      });
    });
  }

  async function loadOwnership(ids, gw, opts = {}) {
    if (ids.length === 0) {
      out.innerHTML = "<p class='status status--error'>No manager IDs found. <a href='/managers'>Add managers here</a>.</p>";
      return;
    }

    if (!gw) {
      out.innerHTML = "<p class='status status--warning'>Please select a gameweek.</p>";
      return;
    }

    const force = !!opts.force;

    // Generate load token for cancellation
    const loadToken = ++currentLoadToken;

    allManagers = [];
    freeHitManagers = new Set();
    out.innerHTML = "";
    loadingStatus.textContent = `Fetching latest data...`;

    // Only bust caches when force=true (Refresh button)
    const cacheBuster = force ? Date.now().toString() : undefined;

    // Fetch manager squads concurrently with limit of 8
    const squadResults = await mapWithConcurrency(
      ids,
      DEFAULT_FETCH_CONCURRENCY,
      async (id) => {
        try {
          return await fetchManagerSquad(id, gw, cacheBuster);
        } catch (e) {
          console.error(`Failed to load manager ${id}:`, e);
          return null;
        }
      },
      (completed, total) => {
        loadingStatus.textContent = `Fetching ${completed}/${total}...`;
      }
    );

    // Check if this load has been superseded
    if (loadToken !== currentLoadToken) {
      console.log('Load superseded, aborting');
      return;
    }

    // Filter out nulls and update data
    const managerSquads = squadResults.filter((data) => data !== null);
    allManagers = managerSquads.map((data) => ({ id: Number(data.entryId), name: data.managerName }));
    freeHitManagers = new Set(managerSquads.filter((data) => data.isFreeHit).map((data) => Number(data.entryId)));

    // Calculate ownership and render table once at the end
    ownershipData = calculateOwnership(managerSquads);
    if (ownershipData.length > 0) {
      populateClubFilter();
      renderOwnershipFromState();
    }

    loadingStatus.innerHTML = `<span class='text-success font-bold'>✅ Loaded ${managerSquads.length} managers</span>`;
    if (lastUpdatedEl) {
      lastUpdatedEl.textContent = formatUpdateTime(Date.now());
    }
    saveOwnershipSnapshot(gw);

  }

  async function init() {
    loadingStatus.textContent = "Loading...";

    const { authenticated, managerIds: ids, favouriteManagerIds: favIds } = await loadManagerIdsFromSupabase();
    if (!authenticated) return;

    managerIds = ids;
    favouriteIds = new Set((favIds || []).map(Number));

    if (managerIds.length === 0) {
      out.innerHTML = "<p class='status status--error'>No manager IDs configured. <a href='/managers'>Add managers here</a>.</p>";
      return;
    }

    // 1) Try local snapshot first (instant, no fetch)
    const snap = loadOwnershipSnapshot();
    if (
      snap &&
      sameManagerIds(snap.managerIds, managerIds) &&
      Array.isArray(snap.ownershipData) &&
      snap.ownershipData.length > 0
    ) {
      ownershipData = snap.ownershipData || [];
      allManagers = snap.allManagers || [];
      freeHitManagers = new Set(snap.freeHitManagers || []);
      latestGW = snap.latestGW || latestGW;

      if (typeof snap.ui?.showFavouritesOnly === "boolean") {
        showFavouritesOnly = snap.ui.showFavouritesOnly;
      }
      updateManagerCountButton();

      populateGWSelector(latestGW);

      if (typeof snap.ui?.gwFilter === "string" && snap.ui.gwFilter) {
        gwFilterSelect.value = snap.ui.gwFilter;
      } else if (snap.gw) {
        gwFilterSelect.value = String(snap.gw);
      }

      if (typeof snap.ui?.positionFilter === "string") {
        positionFilter.value = snap.ui.positionFilter;
      }

      populateClubFilter();
      if (typeof snap.ui?.clubFilter === "string") {
        clubFilter.value = snap.ui.clubFilter;
      }

      renderOwnershipFromState();
      loadingStatus.textContent = "";
      if (lastUpdatedEl) {
        lastUpdatedEl.textContent = formatUpdateTime(snap.savedAt);
      }
      return;
    }

    updateManagerCountButton();

    // 2) No snapshot -> do one normal load (NOT forced)
    loadingStatus.textContent = "Loading player data...";
    await fetchBootstrapData(); // not forced, no ?v=
    await loadOwnership(managerIds, latestGW, { force: false });
  }

  gwFilterSelect.addEventListener("change", async () => {
    const gw = parseInt(gwFilterSelect.value);
    if (!(gw && gw >= 1 && gw <= 38)) return;

    const snap = loadOwnershipSnapshot();
    if (
      snap &&
      sameManagerIds(snap.managerIds, managerIds) &&
      Number(snap.gw) === Number(gw) &&
      Array.isArray(snap.ownershipData) &&
      snap.ownershipData.length > 0
    ) {
      ownershipData = snap.ownershipData || [];
      allManagers = snap.allManagers || [];
      freeHitManagers = new Set(snap.freeHitManagers || []);
      populateClubFilter();
      renderOwnershipFromState();
      loadingStatus.textContent = "";
      if (lastUpdatedEl) {
        lastUpdatedEl.textContent = formatUpdateTime(snap.savedAt);
      }
      return;
    }

    await loadOwnership(managerIds, gw, { force: false });
  });

  positionFilter.addEventListener('change', () => {
    renderOwnershipFromState();
    saveOwnershipSnapshot(parseInt(gwFilterSelect.value) || latestGW);
  });

  clubFilter.addEventListener('change', () => {
    renderOwnershipFromState();
    saveOwnershipSnapshot(parseInt(gwFilterSelect.value) || latestGW);
  });
  
  refreshBtn?.addEventListener("click", async () => {
    localStorage.removeItem(OWNERSHIP_SNAPSHOT_KEY);
    const { authenticated, managerIds: ids, favouriteManagerIds: favIds } = await loadManagerIdsFromSupabase();
    if (!authenticated) return;

    managerIds = ids;
    favouriteIds = new Set((favIds || []).map(Number));
    updateManagerCountButton();

    // Force fresh bootstrap + ownership reload
    const bust = Date.now().toString();
    await fetchBootstrapData(bust);

    const gw = parseInt(gwFilterSelect.value) || latestGW;
    await loadOwnership(managerIds, gw, { force: true });
  });


  init();
</script>
