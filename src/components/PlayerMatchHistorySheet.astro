---
/**
 * PlayerMatchHistorySheet — per-player fixture-by-fixture history top sheet.
 *
 * Opens when the user clicks a player's name in PlayerExplorer.
 * Dispatch: document.dispatchEvent(new CustomEvent('pe:open-history', { detail: { playerId } }))
 */
---

<!-- Backdrop -->
<div id="pmh-backdrop" aria-hidden="true"></div>

<!-- Top-sheet -->
<section
  id="pmh-sheet"
  role="dialog"
  aria-modal="true"
  aria-label="Player Match History"
  aria-hidden="true"
>
  <div class="pmh-header">
    <div class="pmh-header__row">
      <div class="pmh-header__titles">
        <div class="pmh-header__title" id="pmh-title">Match History</div>
        <div class="pmh-header__subtitle" id="pmh-subtitle"></div>
      </div>
      <div class="pmh-filter" role="group" aria-label="Match venue filter" id="pmh-filter">
        <button type="button" class="pmh-filter__btn is-active" data-filter="all" aria-pressed="true">All</button>
        <button type="button" class="pmh-filter__btn" data-filter="home" aria-pressed="false">Home</button>
        <button type="button" class="pmh-filter__btn" data-filter="away" aria-pressed="false">Away</button>
      </div>
      <button type="button" id="pmh-close-btn" class="pmh-close" aria-label="Close Match History">✕</button>
    </div>
  </div>

  <div id="pmh-fixtures" aria-label="Next 5 gameweeks fixtures"></div>

  <div class="pmh-body" id="pmh-body">
    <div class="pmh-status" id="pmh-status">Loading…</div>
  </div>
</section>

<script>
  import "../styles/player-match-history.css";
  import { getBootstrapData } from "../lib/fpl/bootstrapCache";
  import type { BootstrapTeam } from "../lib/fpl/bootstrapCache";
  import {
    computeMatchDC,
    filterHistoryRows,
    formatMatchDate,
    formatOpponentVenue,
    formatScore,
  } from "../lib/playerMatchHistory";
  import type { MatchHistoryRow, VenueFilter } from "../lib/playerMatchHistory";

  interface ElementFixture {
    id: number;
    team_h: number;
    team_a: number;
    is_home: boolean;
    event: number | null;
    difficulty?: number;
    kickoff_time?: string | null;
  }

  // ----------------------------------------------------------------
  // State
  // ----------------------------------------------------------------
  let currentPlayerId = 0;
  let currentElementType = 0;
  let currentFilter: VenueFilter = "all";
  let allRows: MatchHistoryRow[] = [];
  let teamMap: Map<number, BootstrapTeam> = new Map();

  // In-memory caches: playerId → data
  const historyCache = new Map<number, MatchHistoryRow[]>();
  const fixturesCache = new Map<number, ElementFixture[]>();

  // Next 5 upcoming GW ids (set once per session from bootstrap events)
  let upcomingGWs: number[] = [];

  // localStorage cache
  const PMH_LS_KEY = "fpl_pmh_cache_v1";
  const PMH_TTL_MS = 6 * 60 * 60 * 1000; // 6 hours

  interface PMHCacheEntry {
    rows: MatchHistoryRow[];
    fixtures?: ElementFixture[];
    fetchedAt: number;
  }

  function loadHistoryFromStorage(playerId: number): MatchHistoryRow[] | null {
    try {
      const raw = localStorage.getItem(`${PMH_LS_KEY}_${playerId}`);
      if (!raw) return null;
      const p: PMHCacheEntry = JSON.parse(raw);
      if (!Array.isArray(p?.rows) || typeof p.fetchedAt !== "number") return null;
      if (Date.now() - p.fetchedAt > PMH_TTL_MS) return null;
      return p.rows;
    } catch {
      return null;
    }
  }

  function loadFixturesFromStorage(playerId: number): ElementFixture[] {
    try {
      const raw = localStorage.getItem(`${PMH_LS_KEY}_${playerId}`);
      if (!raw) return [];
      const p: PMHCacheEntry = JSON.parse(raw);
      return Array.isArray(p?.fixtures) ? p.fixtures : [];
    } catch {
      return [];
    }
  }

  function saveHistoryToStorage(playerId: number, rows: MatchHistoryRow[], fixtures: ElementFixture[]): void {
    try {
      localStorage.setItem(
        `${PMH_LS_KEY}_${playerId}`,
        JSON.stringify({ rows, fixtures, fetchedAt: Date.now() }),
      );
    } catch {
      /* ignore */
    }
  }

  // ----------------------------------------------------------------
  // DOM refs
  // ----------------------------------------------------------------
  const sheet     = document.getElementById("pmh-sheet")!;
  const backdrop  = document.getElementById("pmh-backdrop")!;
  const closeBtn  = document.getElementById("pmh-close-btn")!;
  const titleEl   = document.getElementById("pmh-title")!;
  const subtitleEl = document.getElementById("pmh-subtitle")!;
  const body      = document.getElementById("pmh-body")!;
  const filterGroup = document.getElementById("pmh-filter")!;
  const fixturesEl  = document.getElementById("pmh-fixtures")!;

  // ----------------------------------------------------------------
  // Filter control
  // ----------------------------------------------------------------
  function setFilter(filter: VenueFilter) {
    currentFilter = filter;
    filterGroup.querySelectorAll<HTMLButtonElement>(".pmh-filter__btn").forEach((btn) => {
      const active = btn.dataset.filter === filter;
      btn.classList.toggle("is-active", active);
      btn.setAttribute("aria-pressed", String(active));
    });
    if (allRows.length > 0) {
      renderHistory(allRows);
    }
  }

  filterGroup.addEventListener("click", (e: Event) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".pmh-filter__btn");
    if (btn?.dataset.filter) setFilter(btn.dataset.filter as VenueFilter);
  });

  // ----------------------------------------------------------------
  // Open / close
  // ----------------------------------------------------------------
  function openSheet() {
    sheet.classList.add("is-open");
    backdrop.classList.add("is-open");
    sheet.setAttribute("aria-hidden", "false");
    backdrop.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    closeBtn.focus();
  }

  function closeSheet() {
    sheet.classList.remove("is-open");
    backdrop.classList.remove("is-open");
    sheet.setAttribute("aria-hidden", "true");
    backdrop.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  closeBtn.addEventListener("click", closeSheet);
  backdrop.addEventListener("click", closeSheet);
  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape" && sheet.classList.contains("is-open")) closeSheet();
  });

  // ----------------------------------------------------------------
  // Load history for a player
  // ----------------------------------------------------------------
  async function loadHistory(playerId: number): Promise<void> {
    body.innerHTML = '<div class="pmh-status">Loading match history…</div>';

    try {
      // Ensure team map is populated
      if (teamMap.size === 0) {
        const bootstrap = await getBootstrapData();
        teamMap = new Map(bootstrap.teams.map((t) => [t.id, t]));

        // All remaining GW ids for the fixture strip (excludes finished & current)
        upcomingGWs = bootstrap.events
          .filter((ev) => !ev.finished && !ev.is_current)
          .sort((a, b) => a.id - b.id)
          .map((ev) => ev.id);

        // Also grab element type for the current player
        const el = bootstrap.elements.find((e) => e.id === playerId);
        if (el) currentElementType = el.element_type;
      }

      // Check in-memory cache
      let rows = historyCache.get(playerId);
      let fixtures = fixturesCache.get(playerId);

      if (!rows) {
        // Check localStorage cache
        const stored = loadHistoryFromStorage(playerId);
        if (stored) {
          rows = stored;
          historyCache.set(playerId, rows);
          if (!fixtures) {
            const storedFx = loadFixturesFromStorage(playerId);
            fixturesCache.set(playerId, storedFx);
            fixtures = storedFx;
          }
        } else {
          // Fetch from API
          const res = await fetch(`/api/fpl/element-summary/${playerId}/`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const json = await res.json();
          rows = (json.history ?? []) as MatchHistoryRow[];
          fixtures = (json.fixtures ?? []) as ElementFixture[];
          historyCache.set(playerId, rows);
          fixturesCache.set(playerId, fixtures);
          saveHistoryToStorage(playerId, rows, fixtures);
        }
      }

      allRows = rows;
      renderFixtures(fixtures ?? []);
      renderHistory(rows);
    } catch (err) {
      body.innerHTML = `<div class="pmh-status">❌ Failed to load match history. <button id="pmh-retry" style="margin-left:8px;cursor:pointer;text-decoration:underline;background:none;border:none;color:var(--color-primary);">Retry</button></div>`;
      document.getElementById("pmh-retry")?.addEventListener("click", () => {
        historyCache.delete(playerId);
        fixturesCache.delete(playerId);
        loadHistory(playerId);
      });
    }
  }

  // ----------------------------------------------------------------
  // Render next-5-GW fixtures strip
  // ----------------------------------------------------------------
  function makeChipHtml(topContent: string, botContent: string, extraClass: string, titleAttr: string): string {
    return `<div class="pmh-fix-chip${extraClass ? ` ${extraClass}` : ""}" title="${titleAttr}">
      <div class="pmh-fix-chip__top">${topContent}</div>
      <div class="pmh-fix-chip__bot">${botContent}</div>
    </div>`;
  }

  function renderFixtures(fixtures: ElementFixture[]): void {
    if (!upcomingGWs.length) {
      fixturesEl.innerHTML = "";
      return;
    }

    // Index fixtures by GW for O(1) lookup
    const gwFixtures = new Map<number, ElementFixture[]>();
    for (const fx of fixtures) {
      if (fx.event != null) {
        const arr = gwFixtures.get(fx.event) ?? [];
        arr.push(fx);
        gwFixtures.set(fx.event, arr);
      }
    }

    const parts: string[] = [];

    for (const gw of upcomingGWs) {
      const gwFxs = gwFixtures.get(gw);

      if (!gwFxs || !gwFxs.length) {
        // Blank GW — same-sized card, shows GW number + "Blank"
        parts.push(makeChipHtml(
          `<span class="pmh-fix-chip__gw-top">GW${gw}</span>`,
          `<span class="pmh-fix-chip__blank-label">Blank</span>`,
          "pmh-fix-chip--blank",
          `GW${gw}: Blank gameweek`,
        ));
      } else {
        for (const fx of gwFxs) {
          const oppTeamId = fx.is_home ? fx.team_a : fx.team_h;
          const team = teamMap.get(oppTeamId);
          const abbr = team?.short_name ?? String(oppTeamId);
          const venue = fx.is_home ? "H" : "A";
          const badgeHtml = team?.code
            ? `<img class="pmh-fix-chip__badge" src="https://resources.premierleague.com/premierleague/badges/t${team.code}.png" alt="${abbr}" width="16" height="16" loading="lazy" />`
            : "";

          parts.push(makeChipHtml(
            `${badgeHtml}<span class="pmh-fix-chip__opp">${abbr}</span>`,
            `<span class="pmh-fix-chip__gw">GW${gw}</span><span class="pmh-fix-chip__venue pmh-fix-chip__venue--${venue.toLowerCase()}">${venue}</span>`,
            "",
            `GW${gw}: ${abbr} (${venue})`,
          ));
        }
      }
    }

    fixturesEl.innerHTML = parts.join("");
  }

  // ----------------------------------------------------------------
  // Render history table
  // ----------------------------------------------------------------
  const isGK  = () => currentElementType === 1;
  const isDEF = () => currentElementType === 2;

  function renderHistory(rows: MatchHistoryRow[]): void {
    if (!rows.length) {
      body.innerHTML = '<div class="pmh-status">No match history available yet.</div>';
      return;
    }

    const filtered = filterHistoryRows(rows, currentFilter);

    if (!filtered.length) {
      subtitleEl.textContent = `0 fixtures`;
      body.innerHTML = '<div class="pmh-status">No matches for the selected filter.</div>';
      return;
    }

    subtitleEl.textContent = `${filtered.length} fixture${filtered.length !== 1 ? "s" : ""}`;

    // Newest first
    const sorted = [...filtered].sort((a, b) => b.round - a.round);

    // Build column headers based on position
    const hasXG = !isGK() && filtered[0]?.expected_goals !== undefined;

    const thead = isGK()
      ? `<thead><tr>
          <th title="Gameweek">GW</th>
          <th title="Opponent">Opp</th>
          <th title="Result">Res</th>
          <th title="Minutes">Mins</th>
          <th title="Total Points">Pts</th>
          <th title="Goals Conceded">GC</th>
          <th title="Expected Goals Conceded">xGC</th>
          <th title="Saves">Svs</th>
          <th title="Penalties Saved">PenSv</th>
          <th title="Bonus Points">Bon</th>
          <th title="Yellow Cards">YC</th>
          <th title="Red Cards">RC</th>
          <th title="Goals">G</th>
          <th title="Assists">A</th>
          <th title="Own Goals">OG</th>
        </tr></thead>`
      : `<thead><tr>
          <th title="Gameweek">GW</th>
          <th title="Opponent">Opp</th>
          <th title="Result">Res</th>
          <th title="Minutes">Mins</th>
          <th title="Total Points">Pts</th>
          <th title="Goals Scored">G</th>
          <th title="Assists">A</th>
          <th title="DC Points">DC</th>
          <th title="Bonus Points">Bon</th>
          ${hasXG ? "<th>xG</th><th>xA</th>" : ""}
          <th title="Goals Conceded">GC</th>
          <th title="Expected Goals Conceded">xGC</th>
          <th title="Yellow Cards">YC</th>
          <th title="Red Cards">RC</th>
          <th title="Own Goals">OG</th>
        </tr></thead>`;

    const tableRows = sorted.map((r) => {
      const team  = teamMap.get(r.opponent_team);
      const opp   = formatOpponentVenue(team?.short_name ?? String(r.opponent_team), r.was_home);
      const score = formatScore(r.was_home, r.team_h_score, r.team_a_score);
      const date  = formatMatchDate(r.kickoff_time);
      const dc    = computeMatchDC(r, currentElementType);

      const gcVal  = r.goals_conceded ?? 0;
      const xgcVal = parseFloat(String(r.expected_goals_conceded ?? "0")).toFixed(2);

      const ptsCls = r.total_points >= 9 ? "pmh-pts--high" : r.total_points <= 1 ? "pmh-pts--low" : "";

      const gVal = r.goals_scored ?? 0;
      const aVal = r.assists ?? 0;
      const gBadge = gVal > 0 ? `<span class="pmh-dc">${gVal}</span>` : "0";
      const aBadge = aVal > 0 ? `<span class="pmh-dc">${aVal}</span>` : "0";

      const posCells = isGK()
        ? `<td>${r.minutes}</td>
           <td class="pmh-pts ${ptsCls}">${r.total_points}</td>
           <td>${gcVal}</td>
           <td>${xgcVal}</td>
           <td>${r.saves ?? 0}</td>
           <td>${r.penalties_saved ?? 0}</td>
           <td>${r.bonus}</td>
           <td>${r.yellow_cards ?? 0}</td>
           <td>${r.red_cards ?? 0}</td>
           <td>${gBadge}</td>
           <td>${aBadge}</td>
           <td>${r.own_goals ?? 0}</td>`
        : `<td>${r.minutes}</td>
           <td class="pmh-pts ${ptsCls}">${r.total_points}</td>
           <td>${gBadge}</td>
           <td>${aBadge}</td>
           <td>${dc > 0 ? `<span class="pmh-dc">${dc}</span>` : "0"}</td>
           <td>${r.bonus}</td>
           ${hasXG ? `<td>${parseFloat(String(r.expected_goals ?? "0")).toFixed(2)}</td><td>${parseFloat(String(r.expected_assists ?? "0")).toFixed(2)}</td>` : ""}
           <td>${gcVal}</td>
           <td>${xgcVal}</td>
           <td>${r.yellow_cards ?? 0}</td>
           <td>${r.red_cards ?? 0}</td>
           <td>${r.own_goals ?? 0}</td>`;

      return `<tr>
        <td class="pmh-gw">${r.round}</td>
        <td class="pmh-opp"><span class="pmh-opp__name">${opp}</span></td>
        <td class="pmh-score">${score}</td>
        ${posCells}
      </tr>`;
    }).join("");

    body.innerHTML = `<div class="pmh-table-wrapper"><table class="pmh-table">${thead}<tbody>${tableRows}</tbody></table></div>`;
  }

  // ----------------------------------------------------------------
  // Event: open history for a player
  // ----------------------------------------------------------------
  document.addEventListener("pe:open-history", async (e: Event) => {
    const { playerId, playerName, elementType } = (e as CustomEvent).detail as {
      playerId: number;
      playerName: string;
      elementType: number;
    };

    currentPlayerId   = playerId;
    currentElementType = elementType;
    allRows = [];

    titleEl.textContent   = playerName;
    subtitleEl.textContent = "";
    fixturesEl.innerHTML   = "";

    setFilter("all");
    openSheet();
    await loadHistory(playerId);
  });
</script>
