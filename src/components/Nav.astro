---
const { pageTitle } = Astro.props;
const navLinks = [
  { href: "/", label: "Home", emoji: "🏠" },
  { href: "/live", label: "Live", emoji: "📡" },
  { href: "/leagues", label: "Leagues", emoji: "🏆" },
  { href: "/stats", label: "Stats", emoji: "🔢" },
  { href: "/transfers", label: "Transfers", emoji: "🔁" },
  { href: "/chips", label: "Chips", emoji: "🎲" },
  { href: "/ownership", label: "Ownership", emoji: "👥" },
  { href: "/squads", label: "Squads", emoji: "🧱" },
  { href: "/players", label: "Players", emoji: "👕" },
  { href: "/managers", label: "Managers", emoji: "👔" },
];
---
<header class="nav-header">
  <nav class="nav">
    <button id="menu-toggle" class="menu-toggle" type="button" aria-label="Toggle menu" aria-expanded="false">
      <span class="hamburger"></span>
    </button>

    {pageTitle && (
      <a href="/" class="nav-brand-stacked" aria-label="FPL Manager Watch">
        <span>FPL</span>
        <span>Manager</span>
        <span>Watch</span>
      </a>
    )}

    {pageTitle ? (
      <span class="nav-page-title">{pageTitle}</span>
    ) : (
      <a href="/" class="nav-brand">FPL Manager Watch</a>
    )}

    <div id="nav-menu" class="nav-menu">
      <div class="nav-menu-header">
        <a href="/" class="nav-brand">FPL Manager Watch</a>
        <div class="nav-menu-header-right">
          <span id="nav-auth-mobile"></span>
         <button id="menu-close" class="menu-close badge badge--danger" type="button" aria-label="Close menu">
           ✕
         </button>
        </div>
      </div>

      <ul class="nav-links">
        {navLinks.map(link => (
          <li>
            <a href={link.href} class="nav-link">
              <span class="nav-link-emoji">{link.emoji}</span>
              {link.label}
            </a>
          </li>
        ))}
        <li id="nav-account-item" style="display: none;">
          <a href="/account" class="nav-link">
            <span class="nav-link-emoji">👤</span>
            Account
          </a>
        </li>
      </ul>

      <div class="nav-secondary">
        <div class="theme-toggle-row">
          <span class="nav-link nav-link--no-hover">
            <span class="nav-link-emoji">🎨</span>
            Theme
          </span>
          <button id="theme-toggle" class="theme-toggle-btn" type="button" aria-label="Toggle theme">
            <span class="theme-icon theme-icon--light">☀️</span>
            <span class="theme-icon theme-icon--dark">🌙</span>
            <span class="theme-toggle-slider"></span>
          </button>
        </div>

        <!-- Desktop only auth -->
        <div class="nav-auth-desktop" id="nav-auth-desktop">
          <a href="/login" class="btn btn--neutral btn--small">Login</a>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-3) var(--space-4);
  }

  .nav-brand {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-brand:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  /* Page title — centered in nav bar on mobile */
  .nav-page-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
  }

  /* Brand stacked (FPL / Manager / Watch) — right of hamburger on mobile */
  .nav-brand-stacked {
    position: absolute;
    left: calc(var(--space-4) + var(--touch-target) + var(--space-2));
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 400;
    line-height: 1.2;
  }

  .nav-brand-stacked:hover {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .menu-toggle {
    position: absolute;
    left: var(--space-4);

    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .hamburger {
    position: relative;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: background var(--transition-fast);
  }

  .hamburger::before,
  .hamburger::after {
    content: "";
    position: absolute;
    left: 0;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform var(--transition-base);
  }

  .hamburger::before { top: -7px; }
  .hamburger::after { top: 7px; }

  .menu-toggle[aria-expanded="true"] .hamburger {
    background: transparent;
  }

  .menu-toggle[aria-expanded="true"] .hamburger::before {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .hamburger::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-menu {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-surface);
    padding: var(--space-4);
    z-index: 150;
    overflow-y: auto;
    flex-direction: column;
  }

  .nav-menu.is-open {
    display: flex;
  }

  .nav-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-2);
  }

  .nav-menu-header-right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .menu-close {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-danger, #e53935);
    color: #fff;
    border: none;
    border-radius: 999px;
    font-size: 1.25rem;
    font-weight: 600;
    width: 32px;
    height: 32px;
    cursor: pointer;
    margin-left: var(--space-3);
    box-shadow: 0 0 4px rgb(0 0 0 / 12%);
    transition: background .2s;
  }

  .menu-close:hover {
    background: var(--color-danger-hover, #d32f2f);
  }

  .nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }

  .nav-link:hover {
    background: var(--color-surface-alt);
    text-decoration: none;
  }

  .nav-link--no-hover:hover {
    background: transparent;
    cursor: default;
  }

  .nav-link-emoji {
    font-size: var(--text-lg);
    width: 24px;
    text-align: center;
  }

  .theme-toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0; /* Remove extra padding - let the inner nav-link handle it */
    margin-top: 0;
  }

  .theme-toggle-row .nav-link {
      padding: var(--space-2) var(--space-3);  /* Match other nav links */
      flex: 1;  /* Allow it to take available space */
  }

  .theme-toggle-btn {
    position: relative;
    width: 56px;
    height: 28px;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6px;
  }

  .theme-icon {
    font-size: 14px;
    z-index: 1;
    transition: opacity var(--transition-fast);
  }

  .theme-icon--light {
    opacity: 0.4;
  }

  .theme-icon--dark {
    opacity: 1;
  }

  :global([data-theme="light"]) .theme-icon--light {
    opacity: 1;
  }

  :global([data-theme="light"]) .theme-icon--dark {
    opacity: 0.4;
  }

  .theme-toggle-slider {
    position: absolute;
    top: 3px;
    left: 31px;
    width: 20px;
    height: 20px;
    background: var(--color-surface);
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
    transition: left var(--transition-base);
  }

  :global([data-theme="light"]) .theme-toggle-slider {
    left: 3px;
  }

  /* Hide desktop auth on mobile */
  .nav-auth-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-brand {
      display: none;
    }

    .nav-page-title {
      display: none;
    }

    .nav-brand-stacked {
      display: none;
    }

    .menu-toggle {
      display: none;
    }

    .nav-menu {
      display: flex;
      position: static;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      background: transparent;
      padding: 0;
      overflow: visible;
      min-width: 0;
      width: 100%;
    }

    .nav-menu-header {
      display: none;
    }

    .nav-links {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-1);
    }

    .nav-link {
      padding: var(--space-2) var(--space-3);
      font-size: var(--text-sm);
      gap: var(--space-2);
    }

    .nav-link-emoji {
      font-size: var(--text-sm);
      width: auto;
    }

    .theme-toggle-row {
      padding: 0;
    }

    #nav-account-item {
      display: none;
    }

    .nav-auth-desktop {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .nav-secondary {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-4);
      flex-wrap: wrap;
    }
  }
</style>

<script>
  import { supabase } from '../lib/supabase.ts'

  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const navMenu = document.getElementById('nav-menu');

  function openMenu() {
    navMenu?.classList.add('is-open');
    menuToggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    navMenu?.classList.remove('is-open');
    menuToggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);

  navMenu?.querySelectorAll('.nav-link').forEach(link => {
    if (link.classList.contains('nav-link--no-hover')) return;
    link.addEventListener('click', closeMenu);
  });

  const themeToggle = document.getElementById('theme-toggle');
  
  function getStoredTheme() {
    const stored = localStorage.getItem('theme');
    if (stored) return stored;
    return 'dark';
  }

  function setTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
  }

  setTheme(getStoredTheme());

  themeToggle?.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    const newTheme = currentTheme === 'light' ? 'dark' : 'light';
    setTheme(newTheme);
  });

  const navAuthMobile = document.getElementById('nav-auth-mobile');
  const navAuthDesktop = document.getElementById('nav-auth-desktop');
  const navAccountItem = document.getElementById('nav-account-item');

  async function updateAuthUI() {
    const { data: { user } } = await supabase.auth.getUser();

    if (user) {
      // Show account link in the nav list (mobile hamburger + desktop list)
      if (navAccountItem) navAccountItem.style.display = '';

      // Mobile: logout button only in header (Account is now in the nav list)
      if (navAuthMobile) {
        navAuthMobile.innerHTML = `
          <button id="logout-btn-mobile" class="btn btn--danger btn--small" type="button">Logout</button>
        `;
        document.getElementById('logout-btn-mobile')?.addEventListener('click', async () => {
          await supabase.auth.signOut();
          window.location.href = '/login';
        });
      }

      // Desktop: user + account + logout
      if (navAuthDesktop) {
        navAuthDesktop.innerHTML = `
          <span class="nav-user">${user.email?.split('@')[0] || 'User'}</span>
          <a href="/account" class="btn btn--neutral btn--small">Account</a>
          <button id="logout-btn-desktop" class="btn btn--neutral btn--small" type="button">Logout</button>
        `;
        document.getElementById('logout-btn-desktop')?.addEventListener('click', async () => {
          await supabase.auth.signOut();
          window.location.href = '/login';
        });
      }
    } else {
      // Not logged in: hide account link in nav list
      if (navAccountItem) navAccountItem.style.display = 'none';

      if (navAuthMobile) {
        navAuthMobile.innerHTML = '';
      }
      if (navAuthDesktop) {
        navAuthDesktop.innerHTML = `<a href="/login" class="btn btn--neutral btn--small">Login</a>`;
      }
    }
  }

  updateAuthUI();

  supabase.auth.onAuthStateChange(() => {
    updateAuthUI();
  });
</script>
