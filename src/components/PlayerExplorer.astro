---
/**
 * PlayerExplorer — player browser.
 *
 * Default (inline=false): global top-sheet modal.
 *   Open by dispatching: document.dispatchEvent(new Event('open-player-explorer'))
 *   Or call window.openPlayerExplorer?.()
 *
 * inline=true: renders as an in-page table (no backdrop, no modal behaviour).
 *   Loads automatically on mount. Used by /players page.
 */
import PlayerMatchHistorySheet from "./PlayerMatchHistorySheet.astro";
const { inline = false } = Astro.props;
---

{!inline && <div id="player-explorer-backdrop" aria-hidden="true"></div>}

<!-- Top-sheet / inline section -->
<section
  id="player-explorer-sheet"
  {...!inline && { role: "dialog", "aria-modal": "true", "aria-label": "Player Explorer", "aria-hidden": "true" }}
  class:list={[{ "pe-inline": inline }]}
  {...inline && { "data-inline": "true" }}
>
  <!-- Header -->
  <div class="pe-header">
    <div>
      <div class="pe-header__title">📋 Player Explorer</div>
      <div class="pe-header__subtitle" id="pe-subtitle">Loading players…</div>
    </div>
    <div class="pe-header__right">
      <button type="button" id="pe-refresh-btn" class="pe-refresh" title="Refresh player data">🔄 Refresh</button>
      {!inline && <button type="button" id="pe-close-btn" class="pe-close" aria-label="Close Player Explorer">✕</button>}
    </div>
  </div>

  <!-- Filters -->
  <div class="pe-filters" role="group" aria-label="Player filters">
    <div class="pe-row1">
      <input
        type="search"
        id="pe-search"
        class="pe-search"
        placeholder="Search player…"
        autocomplete="off"
        aria-label="Search player by name"
      />

      <select id="pe-pos-filter" class="pe-pos-select" aria-label="Filter by position">
        <option value="">All</option>
        <option value="1">GK</option>
        <option value="2">DEF</option>
        <option value="3">MID</option>
        <option value="4">FWD</option>
      </select>
    </div>

    <div class="pe-selects-row">
      <select id="pe-team-filter" class="pe-team-select" aria-label="Filter by team">
        <option value="">All Teams</option>
      </select>

      <select id="pe-price-filter" class="pe-price-select" aria-label="Max price filter">
        <option value="">Max £</option>
        <option value="4.5">£4.5m</option>
        <option value="5.0">£5.0m</option>
        <option value="5.5">£5.5m</option>
        <option value="6.0">£6.0m</option>
        <option value="6.5">£6.5m</option>
        <option value="7.0">£7.0m</option>
        <option value="7.5">£7.5m</option>
        <option value="8.0">£8.0m</option>
        <option value="8.5">£8.5m</option>
        <option value="9.0">£9.0m</option>
        <option value="9.5">£9.5m</option>
        <option value="10.0">£10.0m</option>
        <option value="11.0">£11.0m</option>
        <option value="12.0">£12.0m</option>
        <option value="13.0">£13.0m</option>
      </select>

      {!inline && (
        <select id="pe-stat-view" class="pe-stat-select" aria-label="Choose stat view">
          <option value="overview">Overview</option>
          <option value="attacking">Attacking</option>
          <option value="defensive">Defensive</option>
          <option value="ownership">Ownership / Transfers</option>
          <option value="discipline">Discipline</option>
        </select>
      )}
    </div>
  </div>

  {inline && (
    <div class="pe-agg-toolbar" id="pe-agg-toolbar" role="group" aria-label="Aggregate filters">
      <div class="pe-agg-venue" role="group" aria-label="Venue filter">
        <button type="button" class="pe-agg-btn is-active" data-venue="all">All</button>
        <button type="button" class="pe-agg-btn" data-venue="home">Home</button>
        <button type="button" class="pe-agg-btn" data-venue="away">Away</button>
      </div>
      <span class="pe-agg-sep" aria-hidden="true"></span>
      <div class="pe-agg-window" role="group" aria-label="GW window filter">
        <button type="button" class="pe-agg-win-btn" data-n="3">3GWs</button>
        <button type="button" class="pe-agg-win-btn is-active" data-n="5">5GWs</button>
        <span class="pe-agg-custom">
          <span class="pe-agg-custom-lbl"><span>Last</span><span>GWs</span></span>
          <input
            type="number"
            id="pe-agg-custom-n"
            class="pe-agg-custom-n"
            min="1"
            max="38"
            placeholder="N"
            aria-label="Custom number of GWs"
          />
        </span>
      </div>
    </div>
  )}

  <!-- Body -->
  <div class="pe-body" id="pe-body">
    <div class="pe-status" id="pe-status">Loading…</div>
  </div>
</section>

<!-- Match history sheet — nested here so it's included on every page using PlayerExplorer -->
<PlayerMatchHistorySheet />

<script>
  import "../styles/player-explorer.css";
  import { getBootstrapData, clearBootstrapCache, computeProxyDEFCON, DEFCON_NOTE } from "../lib/fpl/bootstrapCache";
  import type { BootstrapElement, BootstrapTeam, BootstrapStatic } from "../lib/fpl/bootstrapCache";
  import { fetchPlayerAggregates } from "../lib/supabasePlayerAggregates";
  import type { PlayerAggregate, VenueFilter } from "../lib/supabasePlayerAggregates";

  // ----------------------------------------------------------------
  // State
  // ----------------------------------------------------------------
  let bootstrapData: BootstrapStatic | null = null;
  let teamMap: Map<number, BootstrapTeam> = new Map();
  let filterPos = "";
  let filterTeam = "";
  let filterSearch = "";
  let filterMaxPrice = 0; // 0 = no limit; otherwise max price in £m
  let statView = "overview";
  let sortCol = "total_points";
  let sortDir: "asc" | "desc" = "desc";

  // DEFCON: season totals and per-GW breakdown, both derived from FPL live event data.
  // defconMap: player_id → total DC points across all completed GWs (season).
  // defconByGW: gw → (player_id → DC points earned that GW).
  // Both are populated by fetchAndCacheDefcon and used for the DC column.
  let defconMap: Map<number, number> = new Map();
  let defconByGW: Map<number, Map<number, number>> = new Map();
  let defconLoaded = false;

  // Supabase aggregate state (inline mode on /players page only)
  let sbAggMap: Map<number, PlayerAggregate> = new Map();
  let sbAggLoading = false;
  let sbAggError = false;
  let filterVenue: VenueFilter = "all";
  let filterWindow = 5;
  let sbAggReqId = 0; // monotonic counter to ignore stale aggregate responses

  // v2 cache stores per-GW breakdown so the inline table can scope DC to any window.
  const DEFCON_LS_KEY = 'fpl_defcon_cache_v2';
  const DEFCON_TTL_MS = 60 * 60 * 1000; // 1 hour

  function loadDefconFromStorage(): { season: Map<number, number>; byGW: Map<number, Map<number, number>> } | null {
    try {
      const raw = localStorage.getItem(DEFCON_LS_KEY);
      if (!raw) return null;
      const p = JSON.parse(raw) as {
        season: [number, number][];
        byGW: [number, [number, number][]][];
        fetchedAt: number;
      };
      if (!Array.isArray(p?.season) || !Array.isArray(p?.byGW) || typeof p.fetchedAt !== 'number') return null;
      if (Date.now() - p.fetchedAt > DEFCON_TTL_MS) return null;
      const season = new Map<number, number>(p.season);
      const byGW   = new Map<number, Map<number, number>>(
        p.byGW.map(([gw, entries]) => [gw, new Map<number, number>(entries)])
      );
      return { season, byGW };
    } catch { return null; }
  }

  function saveDefconToStorage(season: Map<number, number>, byGW: Map<number, Map<number, number>>): void {
    try {
      localStorage.setItem(DEFCON_LS_KEY, JSON.stringify({
        season: Array.from(season.entries()),
        byGW:   Array.from(byGW.entries()).map(([gw, m]) => [gw, Array.from(m.entries())]),
        fetchedAt: Date.now(),
      }));
    } catch { /* ignore */ }
  }

  async function fetchAndCacheDefcon(elements: BootstrapElement[], events: BootstrapStatic['events']): Promise<void> {
    // 1. Try localStorage cache first
    const cached = loadDefconFromStorage();
    if (cached) {
      defconMap = cached.season;
      defconByGW = cached.byGW;
      defconLoaded = true;
      render();
      return;
    }

    // 2. Determine all completed GWs
    const completedGWs = events.filter(e => e.finished).map(e => e.id);
    if (!completedGWs.length) { defconLoaded = true; return; }

    // 3. Build eligible-player position map (exclude GK)
    const eligible = new Map<number, number>(); // id -> element_type
    elements.forEach(el => {
      if (el.element_type >= 2) eligible.set(el.id, el.element_type);
    });

    // 4. Fetch all completed GW live data in parallel
    const results = await Promise.all(
      completedGWs.map(gw =>
        fetch(`/api/fpl/event/${gw}/live`)
          .then(r => r.ok ? r.json() : null)
          .catch(() => null)
      )
    );

    // 5. Aggregate per-fixture DC points from explain.stats.
    //    Track both season totals (defconMap) and per-GW breakdown (defconByGW)
    //    so the inline table can scope DC to any GW window.
    const newMap  = new Map<number, number>();
    const newByGW = new Map<number, Map<number, number>>();

    results.forEach((data: any, i: number) => {
      const gw = completedGWs[i];
      if (!data?.elements) return;
      const gwMap = new Map<number, number>();

      (data.elements as any[]).forEach(p => {
        if (!eligible.has(p.id)) return;
        const posType = eligible.get(p.id)!;
        const threshold = posType === 2 ? 10 : 12; // DEF:10, MID/FWD:12
        let pts = 0;
        ((p.explain ?? []) as any[]).forEach(fixture => {
          const stats: any[] = fixture.stats ?? [];
          const dc = stats.find((s: any) => s.identifier === 'defensive_contribution');
          if (dc && typeof dc.value === 'number' && dc.value >= threshold) {
            pts += 2;
          }
        });
        if (pts > 0) {
          newMap.set(p.id, (newMap.get(p.id) ?? 0) + pts);
          gwMap.set(p.id, pts);
        }
      });

      if (gwMap.size > 0) newByGW.set(gw, gwMap);
    });

    defconMap  = newMap;
    defconByGW = newByGW;
    defconLoaded = true;
    saveDefconToStorage(newMap, newByGW);
    render(); // re-render with accurate values
  }

  // ----------------------------------------------------------------
  // Supabase aggregate loading (inline mode on /players page only)
  // ----------------------------------------------------------------
  async function loadAggregates() {
    const reqId = ++sbAggReqId;
    sbAggLoading = true;
    sbAggError = false;
    body.innerHTML = '<div class="pe-status" id="pe-status">Loading GW stats…</div>';
    subtitle.textContent = "Loading…";
    try {
      const rows = await fetchPlayerAggregates(filterVenue, filterWindow);
      if (reqId !== sbAggReqId) return; // a newer request supersedes this one
      sbAggMap = new Map(rows.map(r => [r.player_id, r]));
    } catch (e) {
      if (reqId !== sbAggReqId) return; // stale — discard
      console.error("[PlayerExplorer] Supabase aggregate fetch failed:", e);
      sbAggError = true;
      sbAggMap = new Map();
    }
    sbAggLoading = false;
    render();
  }

  // ----------------------------------------------------------------
  // DOM refs (populated on first open)
  // ----------------------------------------------------------------
  const sheet    = document.getElementById("player-explorer-sheet")!;
  const backdrop = document.getElementById("player-explorer-backdrop");
  const closeBtn = document.getElementById("pe-close-btn");
  const refreshBtn = document.getElementById("pe-refresh-btn")!;
  const searchInput = document.getElementById("pe-search") as HTMLInputElement;
  const teamFilter   = document.getElementById("pe-team-filter") as HTMLSelectElement;
  const priceFilter  = document.getElementById("pe-price-filter") as HTMLSelectElement;
  const statSelect   = document.getElementById("pe-stat-view") as HTMLSelectElement;
  const posSelect    = document.getElementById("pe-pos-filter") as HTMLSelectElement | null;
  const body        = document.getElementById("pe-body")!;
  const subtitle    = document.getElementById("pe-subtitle")!;
  const statusEl    = document.getElementById("pe-status")!;

  // ----------------------------------------------------------------
  // Open / close (modal mode only)
  // ----------------------------------------------------------------
  function openExplorer() {
    if (sheet.dataset.inline === "true") return;
    sheet.classList.add("is-open");
    backdrop!.classList.add("is-open");
    sheet.setAttribute("aria-hidden", "false");
    backdrop!.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    closeBtn!.focus();
    loadBootstrap();
  }

  const ALLOWED_FROM_PAGES = new Set(["chips", "live", "transfers", "ownership", "squads", "stats"]);

  function closeExplorer() {
    sheet.classList.remove("is-open");
    backdrop!.classList.remove("is-open");
    sheet.setAttribute("aria-hidden", "true");
    backdrop!.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    const fromPage = new URLSearchParams(window.location.search).get("from");
    if (fromPage && ALLOWED_FROM_PAGES.has(fromPage)) {
      window.location.href = "/" + fromPage;
    }
  }

  const isInline = sheet.dataset.inline === "true";

  if (isInline) {
    // Inline mode: load immediately, no modal open/close behaviour
    loadBootstrap();

    // Wire up venue filter buttons
    document.querySelectorAll<HTMLButtonElement>(".pe-agg-btn[data-venue]").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll<HTMLButtonElement>(".pe-agg-btn[data-venue]")
          .forEach(b => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        filterVenue = (btn.dataset.venue as typeof filterVenue) ?? "all";
        loadAggregates();
      });
    });

    // Wire up GW window preset buttons
    document.querySelectorAll<HTMLButtonElement>(".pe-agg-win-btn[data-n]").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll<HTMLButtonElement>(".pe-agg-win-btn")
          .forEach(b => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        const customInput = document.getElementById("pe-agg-custom-n") as HTMLInputElement | null;
        if (customInput) customInput.value = "";
        filterWindow = parseInt(btn.dataset.n ?? "5", 10);
        loadAggregates();
      });
    });

    // Wire up custom N input
    const customNInput = document.getElementById("pe-agg-custom-n") as HTMLInputElement | null;
    customNInput?.addEventListener("change", () => {
      const n = parseInt(customNInput.value, 10);
      if (n >= 1 && n <= 38) {
        document.querySelectorAll<HTMLButtonElement>(".pe-agg-win-btn")
          .forEach(b => b.classList.remove("is-active"));
        filterWindow = n;
        loadAggregates();
      }
    });
  } else {
    // Modal mode: wire up open/close
    closeBtn?.addEventListener("click", closeExplorer);
    backdrop?.addEventListener("click", closeExplorer);
    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape" && sheet.classList.contains("is-open")) closeExplorer();
    });
    // Global API — pages open explorer via this
    (window as any).openPlayerExplorer = openExplorer;
    document.addEventListener("open-player-explorer", openExplorer);
  }

  // ----------------------------------------------------------------
  // Filters
  // ----------------------------------------------------------------
  posSelect?.addEventListener("change", () => {
    filterPos = posSelect.value;
    render();
  });

  teamFilter.addEventListener("change", () => {
    filterTeam = teamFilter.value;
    render();
  });

  priceFilter.addEventListener("change", () => {
    filterMaxPrice = priceFilter.value ? parseFloat(priceFilter.value) : 0;
    render();
  });

  /**
   * Fold a string for accent-insensitive search.
   * Two-pass approach (from dgita24/FPLPlanner):
   *   1. Explicit char map for characters that DON'T decompose under NFD
   *      (Ø, å, Æ, ð, þ, ß …)
   *   2. NFD + strip combining marks for the rest (é→e, ü→u, ç→c …)
   */
  function foldForSearch(s: string): string {
    const charMap: Record<string, string> = {
      'ø': 'o', 'Ø': 'o',
      'å': 'a', 'Å': 'a',
      'æ': 'ae', 'Æ': 'ae',
      'ð': 'd', 'Ð': 'd',
      'þ': 'th', 'Þ': 'th',
      'ß': 'ss',
    };
    let str = (s ?? '').toString();
    for (const [from, to] of Object.entries(charMap)) {
      str = str.split(from).join(to);
    }
    return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
  }

  searchInput.addEventListener("input", () => {
    filterSearch = foldForSearch(searchInput.value);
    render();
  });

  statSelect?.addEventListener("change", () => {
    statView = statSelect.value;
    sortCol = DEFAULT_SORT[statView] ?? "total_points";
    sortDir = "desc";
    render();
  });

  // ----------------------------------------------------------------
  // Bootstrap loading
  // ----------------------------------------------------------------
  async function loadBootstrap(force = false) {
    statusEl.textContent = "Loading players…";
    body.innerHTML = '<div class="pe-status" id="pe-status">Loading…</div>';
    try {
      bootstrapData = await getBootstrapData(6 * 60 * 60 * 1000, force);
      teamMap = new Map(bootstrapData.teams.map(t => [t.id, t]));
      populateTeamFilter();
      if (isInline) {
        // Inline /players mode: load Supabase aggregated stats (calls render when done)
        loadAggregates();
        // Fetch accurate DEFCON in background; render() will be called again when ready
        fetchAndCacheDefcon(bootstrapData.elements, bootstrapData.events).catch(() => {
          defconLoaded = true;
        });
      } else {
        render();
        // Fetch accurate DEFCON in background; render() will be called again when ready
        fetchAndCacheDefcon(bootstrapData.elements, bootstrapData.events).catch(() => {
          defconLoaded = true;
        });
      }
    } catch (err) {
      body.innerHTML = `<div class="pe-status">❌ Failed to load players. <button id="pe-retry" style="margin-left:8px;cursor:pointer;text-decoration:underline;background:none;border:none;color:var(--color-primary);">Retry</button></div>`;
      document.getElementById("pe-retry")?.addEventListener("click", () => loadBootstrap(true));
    }
  }

  refreshBtn.addEventListener("click", () => {
    clearBootstrapCache();
    if (isInline) {
      sbAggMap = new Map();
      sbAggError = false;
      defconMap = new Map();
      defconByGW = new Map();
      defconLoaded = false;
      try { localStorage.removeItem(DEFCON_LS_KEY); } catch { /* ignore */ }
    } else {
      defconMap = new Map();
      defconByGW = new Map();
      defconLoaded = false;
      try { localStorage.removeItem(DEFCON_LS_KEY); } catch { /* ignore */ }
    }
    loadBootstrap(true);
  });

  function populateTeamFilter() {
    if (!bootstrapData) return;
    const sorted = [...bootstrapData.teams].sort((a, b) => a.name.localeCompare(b.name));
    teamFilter.innerHTML = '<option value="">All Teams</option>' +
      sorted.map(t => `<option value="${t.id}">${t.name}</option>`).join("");
  }

  // ----------------------------------------------------------------
  // Stat columns configuration
  // ----------------------------------------------------------------
  interface ColDef {
    key: string;
    label: string;
    title?: string;
    fn?: (el: BootstrapElement) => number | string;
    numeric?: boolean;
    highlight?: (el: BootstrapElement) => boolean;
  }

  const DEFAULT_SORT: Record<string, string> = {
    overview:   "total_points",
    attacking:  "total_points",
    defensive:  "total_points",
    ownership:  "transfers_in_event",
    discipline: "yellow_cards",
  };

  const COLS: Record<string, ColDef[]> = {
    overview: [
      { key: "price",   label: "£",    title: "Price (£m)", fn: el => (el.now_cost / 10).toFixed(1), numeric: true },
      { key: "total_points", label: "Pts", title: "Total Points", numeric: true },
      { key: "form",    label: "Form", title: "Form (rolling avg)", numeric: true },
      { key: "ppg",     label: "PPG",  title: "Points Per Game", fn: el => el.points_per_game, numeric: true },
      { key: "selected_by_percent_num", label: "Sel%", title: "Selected by % of FPL managers",
        fn: el => el.selected_by_percent, numeric: true },
      { key: "minutes", label: "Min",  title: "Total minutes played", numeric: true },
    ],
    attacking: [
      { key: "total_points", label: "Pts",  numeric: true },
      { key: "goals_scored", label: "GS",   title: "Goals Scored", numeric: true },
      { key: "xg",          label: "xG",   title: "Expected Goals",
        fn: el => parseFloat((el as any).expected_goals ?? "0").toFixed(2), numeric: true },
      { key: "assists",      label: "A",    title: "Assists", numeric: true },
      { key: "xa",          label: "xA",   title: "Expected Assists",
        fn: el => parseFloat((el as any).expected_assists ?? "0").toFixed(2), numeric: true },
      { key: "bonus",        label: "Bon",title: "Bonus Points", numeric: true },
    ],
    defensive: [
      { key: "total_points",   label: "Pts",   numeric: true },
      { key: "clean_sheets",   label: "CS",    title: "Clean Sheets", numeric: true },
      { key: "goals_conceded", label: "GC",    title: "Goals Conceded", numeric: true },
      { key: "xgc",           label: "xGC",  title: "Expected Goals Conceded",
        fn: el => parseFloat((el as any).expected_goals_conceded ?? "0").toFixed(2), numeric: true },
      { key: "defcon",         label: "DC",
        title: `DEFCON points ${DEFCON_NOTE}`,
        fn: el => defconLoaded ? (defconMap.get(el.id) ?? 0) : computeProxyDEFCON(el),
        numeric: true },
      { key: "bonus",        label: "Bon",title: "Bonus Points", numeric: true },
    ],
    ownership: [
      { key: "selected_by_percent_num", label: "Sel%", title: "Selected by % of FPL managers",
        fn: el => el.selected_by_percent, numeric: true },
      { key: "transfers_in_event", label: "GW In",   title: "Transfers in this GW", numeric: true },
      { key: "transfers_out_event",label: "GW Out",   title: "Transfers out this GW", numeric: true },
    ],
    discipline: [
      { key: "yellow_cards",   label: "YC",    title: "Yellow Cards", numeric: true },
      { key: "red_cards",      label: "RC",    title: "Red Cards", numeric: true },
      { key: "penalties_missed",label: "PM",   title: "Penalties Missed", numeric: true },
      { key: "own_goals",      label: "OG",    title: "Own Goals", numeric: true },
      { key: "penalties_saved",label: "PS",    title: "Penalties Saved (GK)", numeric: true },
    ],
  };

  /**
   * Return the column list for the given view, filtered by active position.
   * - Svs (saves) only relevant for GK — hide for DEF/MID/FWD (attacking view)
   */
  function getEffectiveCols(view: string, pos: string): ColDef[] {
    let cols = [...(COLS[view] ?? COLS.overview)];
    const isOutfield = pos === "2" || pos === "3" || pos === "4";
    if (isOutfield) cols = cols.filter(c => c.key !== "saves");
    return cols;
  }

  /**
   * Return aggregated column definitions for inline /players mode.
   * Values are read from sbAggMap (Supabase-backed) at render time.
   * Bootstrap-derived columns (£, Sel%) are read from the element directly.
   */
  function getAggCols(): ColDef[] {
    const agg = (id: number) => sbAggMap.get(id);

    // Compute the last `filterWindow` completed GW IDs from bootstrap once per render.
    // Using bootstrap (not player_match_history's maxGw) keeps the window current even
    // when the Supabase table lags behind by one GW — which is the root cause of the
    // overcounting bug (e.g. Rice showing 8 DC instead of 6 for last 5 GWs).
    const completedGWIds = (bootstrapData?.events ?? [])
      .filter(e => e.finished).map(e => e.id).sort((a, b) => a - b);
    const dcWindowGWs = completedGWIds.slice(-filterWindow);
    const getDCForPlayer = (playerId: number): number => {
      if (!defconLoaded) return 0;
      let total = 0;
      for (const gw of dcWindowGWs) total += defconByGW.get(gw)?.get(playerId) ?? 0;
      return total;
    };

    return [
      { key: "agg_price", label: "£",    title: "Price (£m)",
        fn: (el: BootstrapElement) => (el.now_cost / 10).toFixed(1), numeric: true },
      { key: "agg_gms",   label: "Gms",  title: "Matches in window",
        fn: (el: BootstrapElement) => agg(el.id)?.matches ?? 0, numeric: true },
      { key: "agg_pts",   label: "Pts",  title: "Total points in window",
        fn: (el: BootstrapElement) => agg(el.id)?.total_points ?? 0, numeric: true },
      { key: "agg_avg",   label: "Avg",  title: "Avg points per game",
        fn: (el: BootstrapElement) => agg(el.id)?.avg_points ?? 0, numeric: true },
      { key: "agg_min",   label: "Min",  title: "Minutes played",
        fn: (el: BootstrapElement) => agg(el.id)?.minutes ?? 0, numeric: true },
      { key: "agg_gs",    label: "G",    title: "Goals scored",
        fn: (el: BootstrapElement) => agg(el.id)?.goals_scored ?? 0, numeric: true,
        highlight: (el: BootstrapElement) => (agg(el.id)?.goals_scored ?? 0) > 0 },
      { key: "agg_a",     label: "A",    title: "Assists",
        fn: (el: BootstrapElement) => agg(el.id)?.assists ?? 0, numeric: true,
        highlight: (el: BootstrapElement) => (agg(el.id)?.assists ?? 0) > 0 },
      { key: "agg_dc",    label: "DC",   title: `DEFCON points in window ${DEFCON_NOTE}`,
        fn: (el: BootstrapElement) => getDCForPlayer(el.id), numeric: true,
        highlight: (el: BootstrapElement) => getDCForPlayer(el.id) > 0 },
      { key: "agg_cs",    label: "CS",   title: "Clean sheets",
        fn: (el: BootstrapElement) => agg(el.id)?.clean_sheets ?? 0, numeric: true },
      { key: "agg_bon",   label: "Bon",  title: "Bonus points",
        fn: (el: BootstrapElement) => agg(el.id)?.bonus ?? 0, numeric: true },
      { key: "agg_xg",    label: "xG",   title: "Expected goals",
        fn: (el: BootstrapElement) => agg(el.id)?.expected_goals ?? 0, numeric: true },
      { key: "agg_xa",    label: "xA",   title: "Expected assists",
        fn: (el: BootstrapElement) => agg(el.id)?.expected_assists ?? 0, numeric: true },
      { key: "agg_xgi",   label: "xGI",  title: "Expected goal involvements (xG+xA)",
        fn: (el: BootstrapElement) => agg(el.id)?.expected_goal_involvements ?? 0, numeric: true },
      { key: "agg_gc",    label: "GC",   title: "Goals conceded",
        fn: (el: BootstrapElement) => agg(el.id)?.goals_conceded ?? 0, numeric: true },
      { key: "agg_xgc",   label: "xGC",  title: "Expected goals conceded",
        fn: (el: BootstrapElement) => agg(el.id)?.expected_goals_conceded ?? 0, numeric: true },
      { key: "agg_svs",   label: "Svs",  title: "Saves (GK)",
        fn: (el: BootstrapElement) => agg(el.id)?.saves ?? 0, numeric: true },
      { key: "agg_ps",    label: "PenSv",title: "Penalties saved",
        fn: (el: BootstrapElement) => agg(el.id)?.penalties_saved ?? 0, numeric: true },
      { key: "agg_pm",    label: "PenM", title: "Penalties missed",
        fn: (el: BootstrapElement) => agg(el.id)?.penalties_missed ?? 0, numeric: true },
      { key: "agg_yc",    label: "YC",   title: "Yellow cards",
        fn: (el: BootstrapElement) => agg(el.id)?.yellow_cards ?? 0, numeric: true },
      { key: "agg_rc",    label: "RC",   title: "Red cards",
        fn: (el: BootstrapElement) => agg(el.id)?.red_cards ?? 0, numeric: true },
      { key: "agg_og",    label: "OG",   title: "Own goals",
        fn: (el: BootstrapElement) => agg(el.id)?.own_goals ?? 0, numeric: true },
      { key: "agg_sel",   label: "Sel%", title: "Selected by % of FPL managers",
        fn: (el: BootstrapElement) => el.selected_by_percent, numeric: true },
    ];
  }

  // ----------------------------------------------------------------
  // Rendering
  // ----------------------------------------------------------------
  const POS_LABEL: Record<number, string> = { 1:"GK", 2:"DEF", 3:"MID", 4:"FWD" };

  function getColValue(el: BootstrapElement, col: ColDef): number | string {
    if (col.fn) return col.fn(el);
    const v = (el as any)[col.key];
    return v ?? 0;
  }

  function getNumericValue(el: BootstrapElement, col: ColDef): number {
    const v = getColValue(el, col);
    return typeof v === "number" ? v : parseFloat(String(v)) || 0;
  }

  function renderCell(el: BootstrapElement, c: ColDef): string {
    const val = getColValue(el, c);
    if (c.highlight?.(el)) {
      return `<td><span class="pmh-dc">${val}</span></td>`;
    }
    return `<td>${val}</td>`;
  }

  function render() {
    if (!bootstrapData) return;

    let cols: ColDef[];

    if (isInline) {
      // Inline /players mode: use Supabase aggregated columns
      cols = getAggCols();
      // Ensure sortCol is valid for aggregated columns; reset to default if not
      if (!cols.find(c => c.key === sortCol)) {
        sortCol = "agg_pts";
        sortDir = "desc";
      }
    } else {
      cols = getEffectiveCols(statView, filterPos);
    }

    const activeSortCol = cols.find(c => c.key === sortCol) ?? cols[0];

    // Filter
    let players = bootstrapData.elements.filter(el => {
      if (filterPos && String(el.element_type) !== filterPos) return false;
      if (filterTeam && String(el.team) !== filterTeam) return false;
      if (filterMaxPrice > 0 && el.now_cost / 10 > filterMaxPrice) return false;
      if (filterSearch) {
        const name = foldForSearch(`${el.first_name} ${el.second_name} ${el.web_name}`);
        if (!name.includes(filterSearch)) return false;
      }
      return true;
    });

    // Sort
    players.sort((a, b) => {
      const va = getNumericValue(a, activeSortCol);
      const vb = getNumericValue(b, activeSortCol);
      return sortDir === "desc" ? vb - va : va - vb;
    });

    // Subtitle: show player count + GW range for inline aggregated mode.
    // All rows returned by a single get_player_aggregates RPC call share the same
    // min_gw/max_gw window, so reading from any entry gives the correct range.
    if (isInline && sbAggMap.size > 0) {
      const firstAgg = sbAggMap.values().next().value as PlayerAggregate | undefined;
      const gwRange = firstAgg ? ` · GW ${firstAgg.min_gw}–${firstAgg.max_gw}` : "";
      subtitle.textContent = `${players.length} player${players.length !== 1 ? "s" : ""}${gwRange}`;
    } else {
      subtitle.textContent = `${players.length} player${players.length !== 1 ? "s" : ""}`;
    }

    // Build table HTML
    const showDefconNote = !isInline && statView === "defensive";

    const thead = `<thead><tr>
      <th data-col="name" title="Player">Player</th>
      ${cols.map(c => `<th data-col="${c.key}" title="${c.title ?? c.label}" class="${sortCol === c.key ? (sortDir === "desc" ? "sort-desc" : "sort-asc") : ""}">${c.label}</th>`).join("")}
    </tr></thead>`;

    const rows = players.map(el => {
      const team = teamMap.get(el.team);
      const pos = POS_LABEL[el.element_type] ?? "?";
      const dot = `<span class="pe-status-dot pe-status-dot--${el.status ?? "a"}" title="${el.news || "Available"}"></span>`;
      return `<tr data-id="${el.id}">
        <td class="pe-player-name">${dot}<button class="pe-player-link" data-id="${el.id}" data-name="${el.web_name}" data-etype="${el.element_type}">${el.web_name}</button><br><span class="pe-player-meta">${team?.short_name ?? ""}  ${pos}</span></td>
        ${cols.map(c => renderCell(el, c)).join("")}
      </tr>`;
    }).join("");

    const note = showDefconNote
      ? `<span class="pe-defcon-note">DC ${defconLoaded ? DEFCON_NOTE : '⏳ Loading DC data from GW live stats…'}</span>`
      : "";

    const errorNote = isInline && sbAggError
      ? `<div class="pe-agg-error">⚠️ Could not load GW stats from Supabase. Stats unavailable.</div>`
      : "";

    body.innerHTML = `${errorNote}<div class="pe-table-wrapper"><table class="pe-table">${thead}<tbody>${rows}</tbody></table></div>${note}`;

    // Sort header click
    body.querySelectorAll<HTMLElement>(".pe-table th[data-col]").forEach(th => {
      th.addEventListener("click", () => {
        const col = th.dataset.col ?? "";
        if (col === "name") return;
        if (sortCol === col) {
          sortDir = sortDir === "desc" ? "asc" : "desc";
        } else {
          sortCol = col;
          sortDir = "desc";
        }
        render();
      });
    });

    // Player name button → open match history sheet
    body.querySelectorAll<HTMLButtonElement>(".pe-player-link").forEach(btn => {
      btn.addEventListener("click", (e: MouseEvent) => {
        e.stopPropagation(); // don't trigger row click
        const id    = parseInt(btn.dataset.id   ?? "0",  10);
        const etype = parseInt(btn.dataset.etype ?? "0",  10);
        const name  = btn.dataset.name ?? "";
        if (!id) return;
        document.dispatchEvent(new CustomEvent("pe:open-history", {
          detail: { playerId: id, playerName: name, elementType: etype },
        }));
      });
    });

    // Row click → open player modal if available
    body.querySelectorAll<HTMLElement>(".pe-table tbody tr[data-id]").forEach(row => {
      row.addEventListener("click", () => {
        const id = parseInt(row.dataset.id ?? "0", 10);
        if (!id) return;
        // Try to reuse existing page-level showPlayerModal if available
        if (typeof (window as any).showPlayerModal === "function") {
          (window as any).showPlayerModal(id);
        } else {
          // Dispatch custom event; pages can listen to open their own modal
          document.dispatchEvent(new CustomEvent("pe:player-click", { detail: { playerId: id } }));
        }
      });
    });
  }
</script>
